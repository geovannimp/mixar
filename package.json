{
  "name": "mixar",
  "private": true,
  "engines": {
    "node": ">=24.22.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "lint": "moon run :lint",
    "lint:staged": "moon run :lint-files --affected --status staged",
    "format:check": "moon run :format-check",
    "format:staged": "moon run :format-files --affected --status staged",
    "tokens:build": "moon run style-generator:generate",
    "tokens:check": "moon run style-generator:check",
    "build": "moon run :build",
    "test": "moon run :test",
    "test:affected": "moon run gui-flutter:test-affected",
    "app:linux": "moon run gui-flutter:dev-linux",
    "app:android": "moon run gui-flutter:dev-android",
    "website:dev": "moon run website:dev",
    "website:build": "moon run website:build"
  },
  "devDependencies": {
    "@bundled-es-modules/deepmerge": "file:./packages/style-generator/vendor/deepmerge-safe",
    "@moonrepo/cli": "^2.6.2",
    "lefthook": "2.1.10"
  },
  "allowScripts": {
    "lefthook": true
  },
  "overrides": {
    "katex": "^0.18.2",
    "glob": "^14.0.4",
    "@bundled-es-modules/deepmerge": "$@bundled-es-modules/deepmerge"
  }
}
