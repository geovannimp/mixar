{
  "name": "mixar",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mixar",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "@moonrepo/cli": "^2.4.4",
        "lefthook": "2.1.10"
      },
      "engines": {
        "node": ">=22.18"
      }
    },
    "node_modules/@moonrepo/cli": {
      "version": "2.4.4",
      "dev": true,
      "license": "MIT",
      "dependencies": {
        "detect-libc": "^2.1.2"
      },
      "bin": {
        "moon": "moon.js",
        "moonx": "moonx.js"
      },
      "optionalDependencies": {
        "@moonrepo/core-linux-arm64-gnu": "2.4.4",
        "@moonrepo/core-linux-arm64-musl": "2.4.4",
        "@moonrepo/core-linux-x64-gnu": "2.4.4",
        "@moonrepo/core-linux-x64-musl": "2.4.4",
        "@moonrepo/core-macos-arm64": "2.4.4",
        "@moonrepo/core-macos-x64": "2.4.4",
        "@moonrepo/core-windows-x64-msvc": "2.4.4"
      }
    },
    "node_modules/@moonrepo/core-linux-x64-gnu": {
      "version": "2.4.4",
      "cpu": [
        "x64"
      ],
      "dev": true,
      "license": "MIT",
      "optional": true,
      "os": [
        "linux"
      ]
    },
    "node_modules/@moonrepo/core-linux-x64-musl": {
      "version": "2.4.4",
      "cpu": [
        "x64"
      ],
      "dev": true,
      "license": "MIT",
      "optional": true,
      "os": [
        "linux"
      ]
    },
    "node_modules/detect-libc": {
      "version": "2.1.2",
      "dev": true,
      "license": "Apache-2.0",
      "engines": {
        "node": ">=8"
      }
    },
    "node_modules/lefthook": {
      "version": "2.1.10",
      "dev": true,
      "hasInstallScript": true,
      "license": "MIT",
      "bin": {
        "lefthook": "bin/index.js"
      },
      "optionalDependencies": {
        "lefthook-darwin-arm64": "2.1.10",
        "lefthook-darwin-x64": "2.1.10",
        "lefthook-freebsd-arm64": "2.1.10",
        "lefthook-freebsd-x64": "2.1.10",
        "lefthook-linux-arm64": "2.1.10",
        "lefthook-linux-x64": "2.1.10",
        "lefthook-openbsd-arm64": "2.1.10",
        "lefthook-openbsd-x64": "2.1.10",
        "lefthook-windows-arm64": "2.1.10",
        "lefthook-windows-x64": "2.1.10"
      }
    },
    "node_modules/lefthook-linux-x64": {
      "version": "2.1.10",
      "cpu": [
        "x64"
      ],
      "dev": true,
      "license": "MIT",
      "optional": true,
      "os": [
        "linux"
      ]
    }
  }
}
