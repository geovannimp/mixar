{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/no-relative-parent-imports": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "src-tauri/target/**"]
}
