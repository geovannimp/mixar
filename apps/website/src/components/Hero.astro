---
import { GITHUB_REPO } from "../consts";
import { ArrowDown, Construction, Star } from "@lucide/astro";
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";

const iconProps = { size: 16, "stroke-width": 2 };
const badgeIconProps = { size: 14, "stroke-width": 2 };
---

<section id="hero" class="mx-auto grid max-w-content gap-12 px-6 py-16 pb-20 lg:grid-cols-[1fr_1.1fr] lg:items-center lg:gap-10 lg:py-20 lg:pb-24">
  <div>
    <Badge variant="dev">
      <Construction {...badgeIconProps} aria-hidden="true" />
      In development
    </Badge>
    <h1 class="mb-4 text-[clamp(2.25rem,5vw,3.25rem)] leading-[1.1] font-bold tracking-tight">
      Open-source DJ software built for performance
    </h1>
    <p class="mb-7 max-w-[36ch] text-lg text-muted">
      Dual decks, scrolling waveforms, hot cues, and loops on a cross-platform mixing engine. Free to
      use and expand.
    </p>
    <div class="flex flex-wrap gap-3">
      <Button href={GITHUB_REPO} external>
        <Star {...iconProps} aria-hidden="true" />
        Star on GitHub
      </Button>
      <Button href="#features" variant="secondary">
        Explore features
        <ArrowDown {...iconProps} aria-hidden="true" />
      </Button>
    </div>
  </div>
  <div class="relative overflow-visible lg:py-4">
    <div class="hero-screenshot-stage relative">
      <div class="hero-screenshot-tilt relative">
        <div
          class="pointer-events-none absolute inset-[10%_5%_-5%] hidden bg-[radial-gradient(ellipse_at_center,rgba(45,212,191,0.18),transparent_70%)] dark:block"
          aria-hidden="true"
        >
        </div>
        <img
          class="relative w-full rounded-[20px] border border-border shadow-[var(--screenshot-shadow)]"
          src="/mixar-banner.png"
          alt="Mixar DJ interface with dual decks, waveforms, and mixer"
          width="1024"
          height="733"
        />
      </div>
      <div class="hero-screenshot-shadow hidden lg:block" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  import { initHeroMobileTilt } from "../scripts/hero-mobile-tilt";

  initHeroMobileTilt();
</script>
