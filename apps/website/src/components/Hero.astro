---
import { GITHUB_REPO } from "../consts";
---

<section class="hero">
  <div class="hero-copy">
    <p class="badge">In active development</p>
    <h1>Open-source DJ software built for performance</h1>
    <p class="lead">
      Dual decks, scrolling waveforms, hot cues, loops, and a low-latency Rust audio engine — free
      to use, free to fork, built for desktop and mobile.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">
        Star on GitHub
      </a>
      <a class="btn btn-secondary" href="#features">Explore features</a>
    </div>
    <p class="hero-note">Cross-platform from day one. Every platform is a first-class target.</p>
  </div>
  <div class="hero-visual">
    <div class="hero-glow" aria-hidden="true"></div>
    <img
      class="hero-screenshot"
      src="/mixar-banner.png"
      alt="Mixar DJ interface with dual decks, waveforms, and mixer"
      width="1200"
      height="675"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: 3rem;
    max-width: 1120px;
    margin: 0 auto;
    padding: 4rem 1.5rem 5rem;
  }

  @media (min-width: 960px) {
    .hero {
      grid-template-columns: 1fr 1.1fr;
      align-items: center;
      gap: 2.5rem;
      padding-top: 5rem;
      padding-bottom: 6rem;
    }
  }

  .hero h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .lead {
    margin: 0 0 1.75rem;
    max-width: 36ch;
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .hero-note {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .hero-visual {
    position: relative;
  }

  .hero-glow {
    position: absolute;
    inset: 10% 5% -5%;
    background: var(--hero-glow);
    pointer-events: none;
  }

  .hero-screenshot {
    position: relative;
    width: 100%;
    border-radius: 20px;
    border: 1px solid var(--border);
    box-shadow: var(--screenshot-shadow);
  }
</style>
