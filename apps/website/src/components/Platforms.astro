---
import SectionHeader from "./ui/SectionHeader.astro";

const upcomingPlatforms = ["macOS", "Windows", "iOS", "Android"] as const;

const pillBase =
  "inline-flex items-center justify-center rounded-full border px-4 py-2 text-[0.9375rem] font-medium";
const popover =
  "pointer-events-none invisible absolute bottom-[calc(100%+0.5rem)] left-1/2 z-20 -translate-x-1/2 translate-y-1 rounded-lg border border-border bg-bg-card px-2.5 py-1.5 text-[0.8125rem] font-medium whitespace-nowrap text-fg opacity-0 shadow-lg transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:visible group-focus-visible:translate-y-0 group-focus-visible:opacity-100";
---

<section class="bg-bg-elevated px-6 py-20">
  <SectionHeader
    title="Built for every platform"
    description="Mixar is built with desktop and mobile in mind from the start. One product shaped for every screen you mix on, not a desktop app awkwardly ported elsewhere."
  />
  <ul class="mx-auto mt-8 flex max-w-content flex-wrap justify-center gap-3">
    <li class:list={[pillBase, "border-accent bg-accent-dim text-accent"]}>Linux</li>
    {
      upcomingPlatforms.map((name) => (
        <li>
          <button
            type="button"
            class:list={[
              pillBase,
              "group relative cursor-pointer border-border bg-bg-card text-muted opacity-40 hover:opacity-70 focus-visible:opacity-70",
            ]}
          >
            {name}
            <span class={popover} role="tooltip">
              On roadmap
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</section>
