---
import { MonitorSmartphone } from "@lucide/astro";
import { QUICK_START_URL } from "../consts";
import SectionHeader from "./ui/SectionHeader.astro";

const upcomingPlatforms = ["macOS", "Windows", "iOS", "Android"] as const;
---

<section class="bg-bg-elevated px-section py-24 lg:py-28">
  <SectionHeader
    title="Built for every platform"
    description="Built for desktop and mobile from the start. One product for every screen you mix on, not a desktop app awkwardly ported elsewhere."
  >
    <MonitorSmartphone slot="icon" class="size-20 shrink-0 text-accent" stroke-width={1.75} aria-hidden="true" />
  </SectionHeader>
  <div class="mx-auto mt-10 grid max-w-content gap-5 lg:grid-cols-[1.1fr_0.9fr] lg:gap-6" data-reveal-group>
    <article
      data-reveal
      style="--reveal-delay: 0ms"
      class="flex min-h-[220px] flex-col justify-between rounded-2xl border-2 border-accent/35 bg-bg-card p-10 sm:p-12"
    >
      <div>
        <h3 class="font-serif text-[clamp(1.75rem,4vw,2.5rem)] font-bold leading-tight tracking-tight text-fg">
          In progress
        </h3>
        <p class="mt-2 text-lg text-muted">
          Actively developed. Linux builds available today.
        </p>
      </div>
      <a
        href={QUICK_START_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex w-fit items-center gap-2.5 rounded-full border border-accent bg-accent-dim px-7 py-3.5 text-base font-semibold text-accent transition hover:border-accent-hover hover:bg-accent hover:text-white dark:hover:text-teal-950"
      >
        <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-deck-a" aria-hidden="true"></span>
        Build on Linux
      </a>
    </article>
    <article
      data-reveal
      style="--reveal-delay: 100ms"
      class="flex min-h-[220px] flex-col justify-between rounded-2xl border border-dashed border-border p-10 sm:p-12"
    >
      <h3 class="font-serif text-[clamp(1.75rem,4vw,2.5rem)] font-bold leading-tight tracking-tight text-muted">
        On roadmap
      </h3>
      <ul class="mt-4 space-y-1 font-serif text-[clamp(1.5rem,3.5vw,2.25rem)] font-bold leading-tight tracking-tight text-muted/50">
        {
          upcomingPlatforms.map((name) => (
            <li>{name}</li>
          ))
        }
      </ul>
    </article>
  </div>
</section>
