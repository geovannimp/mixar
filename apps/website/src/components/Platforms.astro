---
const upcomingPlatforms = ["macOS", "Windows", "iOS", "Android"] as const;
---

<section class="section platforms">
  <div class="section-header">
    <h2>Built for every platform</h2>
    <p>
      Mixar is built with desktop and mobile in mind from the start. One product shaped for every
      screen you mix on, not a desktop app awkwardly ported elsewhere.
    </p>
  </div>
  <ul class="platform-pills">
    <li class="platform-pill platform-pill--available">Linux</li>
    {
      upcomingPlatforms.map((name) => (
        <li>
          <button type="button" class="platform-pill platform-pill--soon">
            {name}
            <span class="platform-popover" role="tooltip">
              On roadmap
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .platforms {
    background: var(--bg-elevated);
  }
</style>
