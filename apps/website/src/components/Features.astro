---
import {
  AudioWaveform,
  Disc3,
  Flame,
  Library,
  SlidersHorizontal,
  Usb,
  Volume2,
} from "@lucide/astro";
import FeatureCard from "./ui/FeatureCard.astro";
import SectionHeader from "./ui/SectionHeader.astro";

const iconProps = { size: 16, "stroke-width": 2 };
---

<section id="features" class="px-6 py-20">
  <SectionHeader title="Everything you need" description="Professional mixing tools with no paywall surprises.">
    <Flame slot="icon" class="size-16 shrink-0 text-accent" stroke-width={2} aria-hidden="true" />
  </SectionHeader>
  <div
    id="features-grid"
    class="mx-auto grid max-w-content gap-5 sm:grid-cols-2 lg:grid-cols-3"
    data-reveal-group
  >
    <FeatureCard revealIndex={0} iconTone="deck-a" title="Dual decks">
      <Disc3 slot="icon" {...iconProps} />
      Overview and scrolling waveforms, beat grid, play/pause, seek, and tempo on each deck.
    </FeatureCard>
    <FeatureCard revealIndex={1} iconTone="deck-b" title="Mixer and metering">
      <SlidersHorizontal slot="icon" {...iconProps} />
      Gain, 3-band EQ, filter, volume, crossfader, cue/PFL, and VU meters across the mix bus.
    </FeatureCard>
    <FeatureCard revealIndex={2} title="Performance tools">
      <AudioWaveform slot="icon" {...iconProps} />
      Hot cues, loops, performance pads, sampler, and beat sync for live sets.
    </FeatureCard>
    <FeatureCard revealIndex={3} title="Library and analysis">
      <Library slot="icon" {...iconProps} />
      Folder collections, track metadata, and offline analysis for BPM, key, and loudness.
    </FeatureCard>
    <FeatureCard revealIndex={4} title="MIDI control">
      <Usb slot="icon" {...iconProps} />
      Map any controller you already own—no vendor lock-in or hardware paywalls.
    </FeatureCard>
    <FeatureCard revealIndex={5} title="Low-latency mixing">
      <Volume2 slot="icon" {...iconProps} />
      Responsive decks and a tight mixer feel, built for live performance when timing matters.
    </FeatureCard>
  </div>
</section>

<script>
  import { initRevealGroups } from "../scripts/features-reveal";

  initRevealGroups();
</script>
