---
import {
  AudioWaveform,
  Disc3,
  Flame,
  Library,
  SlidersHorizontal,
  Usb,
  Volume2,
} from "@lucide/astro";
import FeatureCard from "./ui/FeatureCard.astro";
import SectionHeader from "./ui/SectionHeader.astro";

const iconProps = { size: 24, "stroke-width": 2 };
---

<section
  id="features"
  class="relative overflow-hidden border-t border-border bg-bg-elevated px-section py-24 lg:py-28"
>
  <SectionHeader
    eyebrow="01 / Features"
    title="The whole booth"
    description="Two decks, a full mixer, performance pads, and offline analysis. All of it under GPL-3.0."
  >
    <Flame slot="icon" class="size-20 shrink-0 text-accent" stroke-width={1.75} aria-hidden="true" />
  </SectionHeader>
  <div
    id="features-grid"
    class="relative mx-auto grid max-w-content gap-6 sm:grid-cols-2 lg:grid-cols-4"
    data-reveal-group
  >
    <!-- Ghost word sits behind the cards (Kurosawa outline layering):
         absolutely placed so the cards float over it. -->
    <svg
      class="ghost-word pointer-events-none absolute left-1/2 z-0 block w-[90vw] -translate-x-1/2"
      viewBox="0 0 1000 290"
      focusable="false"
      aria-hidden="true"
    >
      <text class="ghost-word-text" x="500" y="250" text-anchor="middle" font-size="315">
        BOOTH
      </text>
    </svg>
    <FeatureCard revealIndex={0} iconTone="deck-a" title="Dual decks" wide>
      <Disc3 slot="icon" {...iconProps} />
      Two full decks with overview and scrolling waveforms, beat grid, play/pause, seek,
      tempo, and key lock to change speed without changing pitch.
    </FeatureCard>
    <FeatureCard revealIndex={1} iconTone="deck-b" title="Mixer and metering" wide>
      <SlidersHorizontal slot="icon" {...iconProps} />
      Gain, 3-band EQ, filter, volume, crossfader, cue/PFL, and VU meters across the mix
      bus.
    </FeatureCard>
    <FeatureCard revealIndex={2} iconTone="accent" title="One pad grid, many modes">
      <AudioWaveform slot="icon" {...iconProps} />
      Hot cues, loop roll, beat jump, sampler, and stems all live on the same pads. Pick
      a mode and the grid becomes that tool.
    </FeatureCard>
    <FeatureCard revealIndex={3} iconTone="accent" title="Library and analysis">
      <Library slot="icon" {...iconProps} />
      Folder collections, track metadata, and offline analysis for BPM, key, loudness,
      and artwork.
    </FeatureCard>
    <FeatureCard revealIndex={4} iconTone="accent" title="Open MIDI mapping">
      <Usb slot="icon" {...iconProps} />
      Map the MIDI controller you already own and keep the layout you know.
    </FeatureCard>
    <FeatureCard revealIndex={5} iconTone="deck-a" title="Low-latency mixing">
      <Volume2 slot="icon" {...iconProps} />
      Tight timing where it counts: nudge the pitch, punch a loop, and fire a cue on the
      beat instead of after it.
    </FeatureCard>
  </div>
</section>

<script>
  import { drawGhostWordOnEnter } from "../lib/ghost-word";
  drawGhostWordOnEnter();
</script>
