---
import {
  PhBooks,
  PhDisc,
  PhFlame,
  PhSlidersHorizontal,
  PhSpeakerHigh,
  PhUsb,
  PhWaveform,
} from "phosphor-icons-astro";
import FeatureCard from "./ui/FeatureCard.astro";
import SectionHeader from "./ui/SectionHeader.astro";

const iconProps = { size: 24, weight: "regular" as const };
---

<section id="features" class="px-section py-24 lg:py-28">
  <SectionHeader title="Everything you need" description="Professional mixing tools with no paywall surprises.">
    <PhFlame slot="icon" class="size-20 shrink-0 text-accent" weight="regular" aria-hidden="true" />
  </SectionHeader>
  <div
    id="features-grid"
    class="mx-auto grid max-w-content gap-6 sm:grid-cols-2 lg:grid-cols-3"
    data-reveal-group
  >
    <FeatureCard revealIndex={0} iconTone="deck-a" title="Dual decks">
      <PhDisc slot="icon" {...iconProps} />
      Overview and scrolling waveforms, beat grid, play/pause, seek, and tempo on each deck.
    </FeatureCard>
    <FeatureCard revealIndex={1} iconTone="deck-b" title="Mixer and metering">
      <PhSlidersHorizontal slot="icon" {...iconProps} />
      Gain, 3-band EQ, filter, volume, crossfader, cue/PFL, and VU meters across the mix bus.
    </FeatureCard>
    <FeatureCard revealIndex={2} iconTone="accent" title="Performance tools">
      <PhWaveform slot="icon" {...iconProps} />
      Hot cues, loops, performance pads, sampler, and beat sync for live sets.
    </FeatureCard>
    <FeatureCard revealIndex={3} iconTone="accent" title="Library and analysis">
      <PhBooks slot="icon" {...iconProps} />
      Folder collections, track metadata, and offline analysis for BPM, key, and loudness.
    </FeatureCard>
    <FeatureCard revealIndex={4} iconTone="accent" title="MIDI control">
      <PhUsb slot="icon" {...iconProps} />
      Map any controller you already own. No vendor lock-in or hardware paywalls.
    </FeatureCard>
    <FeatureCard revealIndex={5} iconTone="deck-a" title="Low-latency mixing">
      <PhSpeakerHigh slot="icon" {...iconProps} />
      Responsive decks and a tight mixer feel, built for live performance when timing matters.
    </FeatureCard>
  </div>
</section>

<script>
  import { initRevealGroups } from "../scripts/features-reveal";

  initRevealGroups();
</script>
