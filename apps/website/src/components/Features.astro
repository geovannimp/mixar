---
import {
  AudioWaveform,
  Disc3,
  Flame,
  Library,
  SlidersHorizontal,
  Usb,
  Volume2,
} from "@lucide/astro";
import FeatureCard from "./ui/FeatureCard.astro";
import SectionHeader from "./ui/SectionHeader.astro";

const iconProps = { size: 24, "stroke-width": 2 };
---

<section id="features" class="border-t border-border bg-bg-elevated px-section py-24 lg:py-28">
  <SectionHeader
    title="The whole booth"
    description="Two decks, a full mixer, performance pads, and offline analysis. All of it open source."
  >
    <Flame slot="icon" class="size-20 shrink-0 text-accent" stroke-width={1.75} aria-hidden="true" />
  </SectionHeader>
  <div
    id="features-grid"
    class="mx-auto grid max-w-content gap-6 sm:grid-cols-2 lg:grid-cols-3"
    data-reveal-group
  >
    <FeatureCard revealIndex={0} iconTone="deck-a" title="Dual decks">
      <Disc3 slot="icon" {...iconProps} />
      Two full decks with overview and scrolling waveforms, beat grid, play/pause, seek,
      tempo, and key lock to change speed without changing pitch.
    </FeatureCard>
    <FeatureCard revealIndex={1} iconTone="deck-b" title="Mixer and metering">
      <SlidersHorizontal slot="icon" {...iconProps} />
      Gain, 3-band EQ, filter, volume, crossfader, cue/PFL, and VU meters across the mix
      bus.
    </FeatureCard>
    <FeatureCard revealIndex={2} iconTone="accent" title="One pad grid, many modes">
      <AudioWaveform slot="icon" {...iconProps} />
      Hot cues, loop roll, beat jump, sampler, and stems all live on the same pads. Pick
      a mode and the grid becomes that tool.
    </FeatureCard>
    <FeatureCard revealIndex={3} iconTone="accent" title="Library and analysis">
      <Library slot="icon" {...iconProps} />
      Folder collections, track metadata, and offline analysis for BPM, key, loudness,
      and artwork.
    </FeatureCard>
    <FeatureCard revealIndex={4} iconTone="accent" title="Open MIDI mapping">
      <Usb slot="icon" {...iconProps} />
      Map the MIDI controller you already own and keep the layout you know. No hardware
      paywall.
    </FeatureCard>
    <FeatureCard revealIndex={5} iconTone="deck-a" title="Low-latency mixing">
      <Volume2 slot="icon" {...iconProps} />
      Tight timing where it counts: nudge the pitch, punch a loop, and fire a cue on the
      beat instead of after it.
    </FeatureCard>
  </div>
</section>

<script>
  import { initRevealGroups } from "../scripts/features-reveal";

  initRevealGroups();
</script>
