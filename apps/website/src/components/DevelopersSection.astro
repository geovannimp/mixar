---
import { GITHUB_REPO } from "../consts";
import {
  AudioLines,
  Code,
  Disc3,
  ExternalLink,
  Handshake,
  Headphones,
  Mic,
  Music3,
  Radio,
  SlidersVertical,
  Volume2,
} from "@lucide/astro";
import Button from "./ui/Button.astro";

const iconProps = { size: 18, "stroke-width": 2 };

const bullets = [
  "Engine, GUI, and library live in one repo",
  "A real-time Rust audio path you can read end to end",
  "Issues and pull requests welcome at every skill level",
] as const;

const bulletClass =
  "relative pl-6 before:absolute before:top-[0.55em] before:left-0 before:h-2 before:w-2 before:rounded-full before:bg-accent";

/** Audio glyphs scattered through the closing constellation, outside the card. */
const constellation = [
  { Icon: Headphones, x: "4%", y: "28%", size: 18, rotate: "-8deg", opacity: 0.32, delay: "-2s" },
  { Icon: AudioLines, x: "95%", y: "24%", size: 16, rotate: "6deg", opacity: 0.28, delay: "-5s" },
  { Icon: Music3, x: "3.5%", y: "72%", size: 15, rotate: "-10deg", opacity: 0.28, delay: "-1s" },
  { Icon: Radio, x: "94%", y: "70%", size: 15, rotate: "8deg", opacity: 0.26, delay: "-6s" },
  { Icon: Disc3, x: "34%", y: "5%", size: 16, rotate: "0deg", opacity: 0.26, delay: "-3s" },
  { Icon: SlidersVertical, x: "68%", y: "5%", size: 15, rotate: "0deg", opacity: 0.24, delay: "-7s" },
  { Icon: Volume2, x: "40%", y: "97%", size: 14, rotate: "0deg", opacity: 0.24, delay: "-8s" },
  { Icon: Mic, x: "60%", y: "97%", size: 14, rotate: "-6deg", opacity: 0.24, delay: "-4s" },
];
---

<section id="developers" class="relative isolate overflow-hidden px-section py-24 lg:pb-28">
  <div class="dev-stage" aria-hidden="true">
    <div class="starfield starfield-far"></div>
    <div class="starfield starfield-near"></div>
    <div class="starfield starfield-accent"></div>
    {
      constellation.map((glyph) => {
        const Icon = glyph.Icon;
        return (
          <span
            class="audio-glyph"
            style={`left: ${glyph.x}; top: ${glyph.y}; --icon-size: ${glyph.size}px; --icon-rotate: ${glyph.rotate}; --icon-opacity: ${glyph.opacity}; --icon-delay: ${glyph.delay};`}
          >
            <Icon size={glyph.size} stroke-width={1.4} />
          </span>
        );
      })
    }
  </div>
  <div
    class="dev-card relative z-10 mx-auto max-w-content rounded-2xl border border-accent/25 px-8 py-14 text-center sm:px-14 sm:py-16"
  >
    <Handshake class="mx-auto mb-6 size-20 text-accent" stroke-width={1.75} aria-hidden="true" />
    <p
      class="mb-4 font-mono text-[0.75rem] font-medium uppercase tracking-[0.18em] text-muted"
    >
      05 / Developers
    </p>
    <h2 class="mb-4 font-serif text-[clamp(2rem,5vw,2.75rem)] font-bold leading-[1.1] tracking-[-0.03em]">
      Open source, top to bottom
    </h2>
    <p class="mx-auto mb-10 max-w-[50ch] text-[1.125rem] leading-relaxed text-muted lg:text-xl">
      Mixar is GPL-3.0. Read the engine, fork it for your booth, or send a fix upstream.
      Bug reports and pull requests are welcome at every experience level.
    </p>
    <ul
      class="mx-auto mb-10 max-w-[32rem] space-y-3 text-left text-base leading-relaxed text-muted"
      data-reveal-group
    >
      {
        bullets.map((text, index) => (
          <li
            data-reveal-x
            style={`--reveal-delay: ${index * 100}ms`}
            class={bulletClass}
          >
            {text}
          </li>
        ))
      }
    </ul>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href={GITHUB_REPO} external placement="developers" class="px-7 py-3.5 text-base">
        <ExternalLink {...iconProps} aria-hidden="true" />
        View source
      </Button>
      <Button href="/developers" variant="secondary" class="px-7 py-3.5 text-base">
        <Code {...iconProps} aria-hidden="true" />
        Developer guide
      </Button>
    </div>
  </div>
</section>
