---
import { GITHUB_REPO } from "../consts";
import Button from "./ui/Button.astro";
import SectionHeader from "./ui/SectionHeader.astro";
---

<section id="developers" class="px-6 py-20">
  <div class="mx-auto max-w-[640px] text-center">
    <SectionHeader
      title="Open source, built with the community"
      description="Mixar is GPL-3.0 licensed and open to contributors. Fork it, extend it, report bugs, or open a pull request, whether you write code or just want to follow along."
    />
    <ul class="mb-7 space-y-2.5 text-left text-[0.9375rem] text-muted">
      <li class="relative pl-5 before:absolute before:top-[0.55em] before:left-0 before:h-1.5 before:w-1.5 before:rounded-full before:bg-accent">
        Inspectable codebase and a modular architecture
      </li>
      <li class="relative pl-5 before:absolute before:top-[0.55em] before:left-0 before:h-1.5 before:w-1.5 before:rounded-full before:bg-accent">
        Real-time audio engine designed for low-latency mixing
      </li>
      <li class="relative pl-5 before:absolute before:top-[0.55em] before:left-0 before:h-1.5 before:w-1.5 before:rounded-full before:bg-accent">
        Issues and pull requests welcome at every skill level
      </li>
    </ul>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href={GITHUB_REPO} external>Star on GitHub</Button>
      <Button href="/developers" variant="secondary">Developer guide</Button>
    </div>
  </div>
</section>
