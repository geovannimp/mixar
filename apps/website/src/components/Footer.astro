---
import { GITHUB_REPO } from "../consts";
---

<footer class="border-t border-border px-6 py-8">
  <div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-4">
    <p class="m-0 flex items-center text-sm text-muted">
      <img
        class="h-5 w-auto brightness-0 dark:invert"
        src="/mixar-logo.png"
        alt="Mixar"
        width="80"
        height="20"
      />
    </p>
    <p class="m-0 text-sm text-muted">
      Licensed under
      <a
        class="underline underline-offset-2 hover:text-fg"
        href="https://www.gnu.org/licenses/gpl-3.0.html"
        target="_blank"
        rel="noopener noreferrer">GPL-3.0</a
      >
      ·
      <a class="underline underline-offset-2 hover:text-fg" href={GITHUB_REPO} target="_blank" rel="noopener noreferrer"
        >Source</a
      >
    </p>
  </div>
</footer>
