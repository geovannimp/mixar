---
import type { DocCategory } from "../../lib/docs";
import { categorySlug, docPath, navLabel } from "../../lib/docs";

interface Props {
  categories: DocCategory[];
  currentId: string;
}

const { categories, currentId } = Astro.props;
const currentCategory = categorySlug(currentId);
// Only the active audience (Users / Developers) — the other stays on /docs.
const visible = categories.filter(
  (category) => category.slug === currentCategory && category.topics.length > 0,
);

// One shared rail (`border-l` on the list); the active item paints over it, so
// nesting is indentation only — no second vertical line.
const rail = "-ml-px block border-l-2 py-1.5 leading-snug transition";
const activeRail = "border-accent font-semibold text-fg";
const idleRail = "border-transparent text-muted hover:border-border-hover hover:text-fg";
---

<nav aria-label="Documentation" class="text-[0.9375rem]">
  {
    visible.map((category) => (
      <div class="mb-8 last:mb-0">
        <p class="mb-3 text-[0.75rem] font-semibold uppercase tracking-wider text-accent">
          {category.name}
        </p>
        {category.topics.map((topic) => (
          <div class="mb-5 last:mb-0">
            <p class="mb-2 font-serif text-[0.8125rem] font-semibold uppercase tracking-wide text-muted">
              {topic.name}
            </p>
            <ul class="m-0 list-none border-l border-border p-0">
              {topic.nav.map((node) => {
                const current = node.entry.id === currentId;
                return (
                  <li class="m-0">
                    <a
                      href={docPath(node.entry.id)}
                      aria-current={current ? "page" : undefined}
                      class:list={[rail, "pl-3", current ? activeRail : idleRail]}
                    >
                      {navLabel(node)}
                    </a>
                    {node.children.length > 0 && (
                      <ul class="m-0 list-none p-0">
                        {node.children.map((child) => {
                          const childCurrent = child.entry.id === currentId;
                          return (
                            <li class="m-0">
                              <a
                                href={docPath(child.entry.id)}
                                aria-current={childCurrent ? "page" : undefined}
                                class:list={[
                                  rail,
                                  "pl-6 text-[0.875rem]",
                                  childCurrent ? activeRail : idleRail,
                                ]}
                              >
                                {navLabel(child)}
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    ))
  }
</nav>
