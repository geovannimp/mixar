---
import { GITHUB_REPO } from "../consts";
---

<section id="open-source" class="section open-source">
  <div class="cta-panel">
    <h2>Open source, contributions welcome</h2>
    <p>
      Mixar is licensed under GPL-3.0. Fork it, extend it, report bugs, or open a pull request —
      all skill levels are welcome.
    </p>
    <a class="btn btn-primary" href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">
      View on GitHub
    </a>
  </div>
</section>
