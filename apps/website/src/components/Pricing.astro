---
import { BadgeDollarSign, Check } from "@lucide/astro";
import SectionHeader from "./ui/SectionHeader.astro";

const checkProps = { "stroke-width": 2.5 };

const rows = [
  { label: "Every feature", mixar: "Included", other: 'Held for a "pro" tier' },
  { label: "MIDI controller", mixar: "Any device, no fee", other: "Per-controller unlock" },
  { label: "Stems", mixar: "Built in, offline", other: "Paid add-on" },
  { label: "Account", mixar: "None required", other: "Sign-in required" },
  { label: "Source code", mixar: "GPL-3.0, yours to keep", other: "Closed" },
] as const;
---

<section id="pricing" class="band-teal scroll-mt-20 border-y border-border bg-bg px-section py-24 lg:py-28">
  <SectionHeader
    eyebrow="03 / Pricing"
    title="DJ software without the asterisks"
    description="Every Mixar feature ships under GPL-3.0. Here is how that stacks up against subscription DJ apps."
  >
    <BadgeDollarSign slot="icon" class="size-20 shrink-0 text-accent" stroke-width={1.75} aria-hidden="true" />
  </SectionHeader>

  <div class="mx-auto max-w-content" data-reveal-group>
    <div data-reveal-y="up" style="--reveal-delay: 0ms" class="overflow-hidden rounded-2xl border border-border bg-bg-card">
      <div class="overflow-x-auto">
        <table class="pricing-table w-full border-collapse text-left sm:min-w-[40rem]" role="table">
          <caption class="sr-only">Mixar price and feature comparison</caption>
          <thead role="rowgroup">
            <tr class="border-b border-border" role="row">
              <th scope="col" role="columnheader" class="p-5 align-bottom text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-muted sm:p-6">
                Compare
              </th>
              <th scope="col" role="columnheader" class="p-5 align-bottom sm:p-6">
                <span class="block font-serif text-[2.75rem] font-bold leading-none tracking-[-0.03em] text-accent">
                  $0
                </span>
                <span class="mt-2 block text-[0.9375rem] font-semibold text-fg">Mixar</span>
                <span class="block text-[0.8125rem] text-muted">Free as in freedom</span>
              </th>
              <th scope="col" role="columnheader" class="p-5 align-bottom sm:p-6">
                <span class="block font-serif text-[1.5rem] font-bold leading-none tracking-[-0.02em] text-muted">
                  Pay monthly
                </span>
                <span class="mt-2 block text-[0.9375rem] font-semibold text-muted">Most DJ apps</span>
                <span class="block text-[0.8125rem] text-muted">Then pay again to unlock</span>
              </th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {
              rows.map((row) => (
                <tr class="border-b border-border last:border-b-0" role="row">
                  <th
                    scope="row"
                    role="rowheader"
                    class="p-5 align-middle text-[0.9375rem] font-medium text-muted sm:p-6"
                  >
                    {row.label}
                  </th>
                  <td role="cell" class="p-5 align-middle sm:p-6">
                    <span class="flex items-center gap-2 text-[0.9375rem] font-medium text-fg">
                      <Check {...checkProps} class="size-4 shrink-0 text-accent" aria-hidden="true" />
                      {row.mixar}
                    </span>
                  </td>
                  <td role="cell" class="p-5 align-middle text-[0.9375rem] text-muted sm:p-6">
                    {row.other}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  /* Below sm: keep the two plan headers side by side, but stack each feature
     as label → Mixar → other so values are not squeezed into half-width cells. */
  @media (max-width: 639px) {
    .pricing-table,
    .pricing-table thead,
    .pricing-table tbody,
    .pricing-table tbody tr,
    .pricing-table tbody th,
    .pricing-table tbody td {
      display: block;
      width: 100%;
    }

    .pricing-table thead tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .pricing-table thead th:first-child {
      display: none;
    }

    .pricing-table thead th {
      padding: 1rem 1.25rem;
    }

    .pricing-table tbody th {
      padding: 1rem 1.25rem 0.25rem;
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .pricing-table tbody td {
      padding: 0.5rem 1.25rem;
    }

    .pricing-table tbody td:last-child {
      padding-bottom: 1rem;
    }
  }
</style>
