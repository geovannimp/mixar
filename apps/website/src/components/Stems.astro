---
import {
  AudioLines,
  Disc3,
  FileMusic,
  Pause,
  Play,
  SlidersHorizontal,
  Zap,
} from "@lucide/astro";
import { NI_STEMS_URL } from "../consts";
import { IDLE_BAR_HEIGHT, STEM_DEMO_TITLE } from "../scripts/stem-demo-player";

/** NI / stemgen default stem order, labels, and colors. */
const stems = [
  { label: "Drums", color: "var(--stem-drums)" },
  { label: "Bass", color: "var(--stem-bass)" },
  { label: "Other", color: "var(--stem-other)" },
  { label: "Vocals", color: "var(--stem-vocals)" },
] as const;

const padModes = ["Cue", "Roll", "Jump", "Sample", "Stems"] as const;

/** The two pad rows share every attribute, differing only by action and label. */
const padRows = [
  { action: "mute", label: "mute" },
  { action: "solo", label: "solo" },
] as const;

/** Shared styling for a mute/solo pad button — hairline stem-tinted border at rest; when lit the pad fills with the stem color like a hardware button. */
const padClass =
 "group flex aspect-square cursor-pointer flex-col items-center justify-center gap-2 rounded-md border border-[color-mix(in_srgb,var(--stem)_40%,var(--border))] bg-bg-card text-muted transition-[border-color,background-color,color,transform] duration-150 hover:-translate-y-px hover:border-(--stem) active:translate-y-0 data-[lit=true]:border-(--stem) data-[lit=true]:bg-(--stem) data-[lit=true]:text-white motion-reduce:transition-none";

const iconProps = { size: 18, "stroke-width": 2 };

/** Bar counts for the mirrored center-line waveform: dense on desktop, fewer
 * on phones so every bar keeps a visible width. Each variant maps the full
 * track; CSS decides which renders. Real heights are injected by
 * stem-demo-ui.ts once the demo audio decodes. Until then the bars render at a
 * minimal skeleton height so no fake shape flashes. */
const DESKTOP_WAVE_BARS = 120;
const MOBILE_WAVE_BARS = 32;

const points = [
  {
    icon: "lines",
    title: "Plays NI Stems natively",
    body: "Drop a Stem file on a deck and every part is ready to play.",
  },
  {
    icon: "zap",
    title: "Splits any track into four",
    body: "A normal track can be separated into drums, bass, other, and vocals, so your whole library becomes mixable.",
  },
  {
    icon: "sliders",
    title: "Mute and solo live",
    body: "The deck's pads mute any part or solo one on its own, so you can change the arrangement while the track plays.",
  },
  {
    icon: "file",
    title: "Ready next time you load it",
    body: "Mixar keeps the four parts together with the track, so they're waiting the next time the track hits a deck.",
  },
] as const;
---

<section id="stems" class="scroll-mt-20 border-y border-border bg-bg">
  <div class="relative h-[26vh] min-h-[200px] overflow-hidden border-b border-border">
    <video
      data-stems-band
      class="absolute inset-0 size-full object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    >
      <source src="/demo/track.stem.mp4" type="video/mp4" />
    </video>
    <div
      class="absolute inset-0 bg-linear-to-t from-bg via-bg/55 to-bg/10"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto flex h-full max-w-content flex-col justify-end px-section pb-9">
      <p
        class="mb-3 font-mono text-[0.75rem] font-medium uppercase tracking-[0.18em] text-muted"
      >
        02 / NI Stems
      </p>
      <h2 class="text-[clamp(2rem,5vw,2.75rem)] font-bold leading-[1.08] tracking-[-0.03em]">
        Four stems. One file.
      </h2>
    </div>
  </div>
  <div class="mx-auto max-w-content px-section py-24 lg:py-28">
    <div class="grid items-stretch gap-14 lg:grid-cols-[1fr_1.05fr] lg:items-center lg:gap-20" data-reveal-group>
      <div data-reveal style="--reveal-delay: 0ms" class="min-w-0 w-full">
        <p
          class="max-w-[46ch] text-[1.125rem] leading-relaxed text-muted lg:text-xl"
        >
          A Stem file is a track split into drums, bass, other, and vocals. Mixar plays
          NI Stems on a deck, so you can pull vocals for an a cappella, cut drums for a
          breakdown, or solo one part. If you do not have Stem files yet, Mixar can split
          any track into four offline.
        </p>

        <ul class="mt-9 grid gap-x-8 gap-y-6 sm:grid-cols-2">
          {
            points.map((point) => (
              <li class="flex gap-3.5">
                <span
                  class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg bg-accent-dim text-accent [&_svg]:size-[18px]"
                  aria-hidden="true"
                >
                  {point.icon === "lines" && <AudioLines {...iconProps} />}
                  {point.icon === "zap" && <Zap {...iconProps} />}
                  {point.icon === "sliders" && <SlidersHorizontal {...iconProps} />}
                  {point.icon === "file" && <FileMusic {...iconProps} />}
                </span>
                <div>
                  <h3 class="mb-1 font-serif text-base font-bold leading-snug tracking-tight">
                    {point.title}
                  </h3>
                  <p class="text-[0.9375rem] leading-relaxed text-muted">
                    {point.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>

        <p class="mt-8 text-[0.9375rem] leading-relaxed text-muted">
          Stems are an open format from
          {" "}
          <a
            class="font-medium text-fg underline underline-offset-4 transition hover:text-accent"
            href={NI_STEMS_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            Native Instruments</a
          >. Mixar plays existing Stem files and can build one from a track you already own.
        </p>
      </div>

      <div data-stems-demo data-reveal-x="right" style="--reveal-delay: 100ms" class="min-w-0 w-full rounded-2xl border border-border bg-bg-card p-5 sm:p-7">
        <div class="mb-5 flex flex-wrap items-center gap-3">
          <ul class="flex flex-wrap items-center gap-1.5" aria-label="Pad modes">
            {
              padModes.map((mode) => (
                <li
                  class:list={[
                    "rounded-full px-2.5 py-1 text-[0.8125rem] font-semibold uppercase tracking-[0.06em]",
                    mode === "Stems"
                      ? "bg-accent text-white dark:text-teal-950"
                      : "border border-border text-muted",
                  ]}
                  aria-current={mode === "Stems" ? "true" : undefined}
                >
                  {mode}
                </li>
              ))
            }
          </ul>
        </div>

        <div
          data-stem-player
          class="mb-5 overflow-hidden rounded-xl border border-border bg-bg"
        >
          <div class="flex items-center gap-3 px-3 pt-3 pb-2">
            <button
              type="button"
              data-stem-play
              data-playing="false"
              aria-label="Play"
              class="group relative flex size-9 shrink-0 items-center justify-center rounded-md border border-border bg-bg-card text-fg transition hover:border-accent hover:text-accent data-[playing=true]:border-accent data-[playing=true]:text-accent disabled:opacity-50"
            >
              <Play
                size={16}
                stroke-width={2.25}
                class="translate-x-px group-data-[playing=true]:hidden"
                aria-hidden="true"
              />
              <Pause
                size={16}
                stroke-width={2.25}
                class="hidden group-data-[playing=true]:block"
                aria-hidden="true"
              />
            </button>
            <div class="min-w-0 flex-1">
              <span
                data-stem-title
                class="block truncate text-sm font-semibold leading-snug text-fg"
              >
                {STEM_DEMO_TITLE}
              </span>
              <div
                class="mt-1 flex items-center justify-between gap-3 font-mono text-[0.75rem] tabular-nums text-muted"
              >
                <span data-stem-remaining>-0:00.0</span>
                <span data-stem-duration>0:00.0</span>
              </div>
            </div>
          </div>
          <div
            data-stem-wave-wrap
            class="relative h-14 cursor-pointer touch-none bg-black select-none"
            role="slider"
            tabindex="0"
            aria-label="Seek"
            aria-disabled="true"
            aria-valuemin="0"
            aria-valuemax="1"
            aria-valuenow="0"
            aria-valuetext="0:00.0 of 0:00.0"
          >
            <canvas data-stem-wave class="absolute inset-0 size-full"></canvas>
            <p
              data-stem-player-status
              role="status"
              aria-live="polite"
              class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/70 px-3 text-center text-[0.75rem] text-muted"
              hidden
            ></p>
          </div>
        </div>

        <div class="grid grid-cols-4 gap-3" role="group" aria-label="Stems mute and solo pads">
          {
            padRows.flatMap((row) =>
              stems.map((stem, index) => (
                <button
                  type="button"
                  data-stem-pad
                  data-action={row.action}
                  data-stem={index}
                  aria-pressed="false"
                  style={`--stem: ${stem.color}`}
                  class={padClass}
                >
                  <span
                    class="size-2 rounded-full bg-(--stem) opacity-40 transition-opacity duration-150 group-data-[lit=true]:bg-white group-data-[lit=true]:opacity-100 motion-reduce:transition-none"
                    aria-hidden="true"
                  ></span>
                  <span class="font-mono text-[0.625rem] font-medium uppercase tracking-[0.14em] group-data-[lit=true]:text-white/80">
                    {row.label}
                  </span>
                  <span class="font-serif text-base font-bold leading-tight tracking-tight text-fg group-data-[lit=true]:text-white">{stem.label}</span>
                </button>
              )),
            )
          }
        </div>

        <div class="mt-6 border-t border-border pt-5">
          <div class="mb-3 flex items-center justify-between gap-3">
            <span
              class="text-[0.8125rem] font-semibold uppercase tracking-[0.08em] text-muted"
            >
              Audible
            </span>
            <button
              type="button"
              data-stem-reset
              class="text-[0.8125rem] font-semibold text-muted transition hover:text-accent"
            >
              Reset
            </button>
          </div>
          <div class="flex w-full h-64 items-stretch justify-center py-4" aria-hidden="true">
            <span
              data-stem-disc
              data-playing="false"
              class="flex shrink-0 items-center justify-center text-accent"
            >
              <Disc3 size={34} stroke-width={1.5} />
            </span>
            <svg
              data-stem-connector
              class="h-full w-8 shrink-0 sm:w-10 [&_path]:fill-none [&_path]:[stroke:color-mix(in_srgb,var(--accent)_55%,var(--border))] [&_path]:[stroke-width:1.5] [&_path]:[stroke-linecap:round] [&_path]:[vector-effect:non-scaling-stroke]"
              viewBox="0 0 48 152"
              preserveAspectRatio="none"
              focusable="false"
            >
              <path data-stem="0" d="M0 76 C24 76 24 16 48 16" />
              <path data-stem="1" d="M0 76 C24 76 24 56 48 56" />
              <path data-stem="2" d="M0 76 C24 76 24 96 48 96" />
              <path data-stem="3" d="M0 76 C24 76 24 136 48 138" />
            </svg>
            <ul class="flex min-w-0 grow flex-col gap-4">
              {
                stems.map((stem, index) => (
                  <li
                    data-stem-lane
                    data-stem={index}
                    data-audible="true"
                    style={`--stem: ${stem.color}`}
                    class="flex w-full min-w-0 grow flex-row items-center justify-between gap-2 transition-[opacity,filter] duration-300 data-[audible=false]:opacity-25 data-[audible=false]:grayscale motion-reduce:transition-none"
                  >
                    <span class="flex w-16 shrink-0 items-center gap-2 pl-2 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-muted">
                      <span class="size-2 shrink-0 rounded-full bg-(--stem)" aria-hidden="true"></span>
                      {stem.label}
                    </span>
                    {(
                      [
                        {
                          variant: "desktop",
                          count: DESKTOP_WAVE_BARS,
                          visibility: "hidden sm:flex",
                        },
                        {
                          variant: "mobile",
                          count: MOBILE_WAVE_BARS,
                          visibility: "flex sm:hidden",
                        },
                      ] as const
                    ).map(({ variant, count, visibility }) => (
                      <span
                        data-stem-bars
                        data-variant={variant}
                        class:list={[
                          "h-full min-w-0 grow items-center gap-[0.5px] motion-reduce:transition-none",
                          visibility,
                        ]}
                      >
                        {Array.from({ length: count }).map(() => (
                          <i class="min-w-[1px] grow bg-(--stem)" style={`height: ${IDLE_BAR_HEIGHT}`} />
                        ))}
                      </span>
                    ))}
                  </li>
                ))
              }
            </ul>
          </div>
          <p class="mt-4 text-[0.8125rem] leading-relaxed text-muted">
            Demo track from the
            {" "}
            <a
              class="font-medium text-fg underline underline-offset-4 transition hover:text-accent"
              href={NI_STEMS_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              Native Instruments</a
            >
            {" "}
            free Stems pack.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import {
    initStemConnectorFlow,
    type StemConnectorFlow,
  } from "../scripts/stem-connector-flow";
  import {
    initStemDemoPlayer,
    type StemDemoPlayerHandle,
  } from "../scripts/stem-demo-ui";

  const initStemsDemo = (
    root: HTMLElement,
    connectorFlow?: StemConnectorFlow,
    audio?: StemDemoPlayerHandle,
  ) => {
    const pads = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-stem-pad]"));
    const lanes = Array.from(root.querySelectorAll<HTMLElement>("[data-stem-lane]"));
    const resetButton = root.querySelector<HTMLButtonElement>("[data-stem-reset]");

    // Derive state width from the rendered lanes so this can't drift from the
    // `stems` array that produced them.
    const mutes = lanes.map(() => false);
    let isolate: number | null = null;

    const render = () => {
      const audible =
        isolate === null ? mutes.map((muted) => !muted) : mutes.map((_, i) => i === isolate);

      for (const pad of pads) {
        const index = Number(pad.dataset.stem);
        const isMute = pad.dataset.action === "mute";
        const lit = isMute ? mutes[index] : isolate === index;
        pad.dataset.lit = String(lit);
        pad.setAttribute("aria-pressed", String(lit));
      }

      for (const lane of lanes) {
        const index = Number(lane.dataset.stem);
        lane.dataset.audible = String(audible[index]);
        connectorFlow?.setAudible(index, audible[index]);
      }

      audio?.setAudible(audible);
    };

    const reset = () => {
      mutes.fill(false);
      isolate = null;
      render();
    };

    for (const pad of pads) {
      pad.addEventListener("click", () => {
        const index = Number(pad.dataset.stem);
        if (pad.dataset.action === "mute") {
          // Mute always has an audible effect, so drop any solo first.
          isolate = null;
          mutes[index] = !mutes[index];
        } else {
          // Solo is exclusive; clear stored mutes so pad states stay honest.
          mutes.fill(false);
          isolate = isolate === index ? null : index;
        }
        render();
      });
    }

    resetButton?.addEventListener("click", reset);

    render();
  };

  // The band video is decorative motion: hold it on frame one when the visitor
  // asked for reduced motion (autoplay is a HTML attribute, so JS undoes it).
  const bandVideo = document.querySelector<HTMLVideoElement>("[data-stems-band]");
  if (bandVideo?.autoplay && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    bandVideo.removeAttribute("autoplay");
    bandVideo.pause();
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-stems-demo]")) {
    if (root.dataset.stemsInit !== undefined) continue;
    root.dataset.stemsInit = "";
    const connectorFlow = initStemConnectorFlow(root);
    initStemsDemo(
      root,
      connectorFlow,
      initStemDemoPlayer(root, {
        onPlayingChange: (playing) => connectorFlow?.setPlaying(playing),
      }),
    );
  }
</script>
