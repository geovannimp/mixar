---
import { Headphones } from "@lucide/astro";
---

<section class="bg-bg-elevated px-6 py-20">
  <div class="mx-auto max-w-[640px] text-center">
    <h2
      class="mb-4 flex flex-col items-center gap-3 text-[clamp(1.75rem,4vw,2.25rem)] font-bold tracking-tight"
    >
      <Headphones class="size-16 shrink-0 text-accent" stroke-width={2} aria-hidden="true" />
      DJ software that respects you
    </h2>
    <p class="mb-4 text-[1.0625rem] text-muted">
      Mixar is built for DJs who want professional tools without vendor lock-in. No features hidden
      behind a paywall, and software designed for how you mix today, not how the industry mixed a
      decade ago.
    </p>
    <p class="text-[1.0625rem] text-muted">
      Desktop or mobile: play your music wherever you're comfortable, with a booth that travels with
      you.
    </p>
  </div>
</section>
