---
import { Headphones } from "@lucide/astro";
import SectionHeader from "./ui/SectionHeader.astro";
---

<section class="bg-bg-elevated px-6 py-20">
  <div class="mx-auto max-w-[640px] text-center">
    <SectionHeader
      title="DJ software that respects you"
      description="Mixar is built for DJs who want professional tools without vendor lock-in—no features hidden behind a paywall, and software designed for how you mix today, not how the industry mixed a decade ago."
    >
      <Headphones slot="icon" class="size-16 shrink-0 text-accent" stroke-width={2} aria-hidden="true" />
    </SectionHeader>
    <p class="-mt-4 mx-auto max-w-[48ch] text-[1.0625rem] leading-relaxed text-muted">
      Desktop or mobile: mix wherever you're comfortable, with a booth that travels with you.
    </p>
  </div>
</section>
