---
import { README_URL, CONTRIBUTING_URL } from "../consts";
import Button from "./ui/Button.astro";
---

<section class="px-6 pt-20 pb-24">
  <div
    class="mx-auto max-w-[640px] rounded-[20px] border border-border bg-linear-to-br from-accent-dim to-transparent to-60% px-8 py-12 text-center"
  >
    <h2 class="mb-3 text-[clamp(1.5rem,3vw,1.875rem)] font-bold tracking-tight">Get involved</h2>
    <p class="mb-6 text-muted">
      Setup, prerequisites, and local development are in the repository README. Contribution
      expectations and how to open pull requests are on GitHub too.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <Button href={README_URL} external>README</Button>
      <Button href={CONTRIBUTING_URL} external variant="secondary">Contributing</Button>
    </div>
  </div>
</section>
