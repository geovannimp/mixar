---
/**
 * Static architecture diagram — the Flutter UI opens one event stream from
 * BusTransport and sends commands through the domain transports; every engine,
 * library and controller event is one typed enum on one bus.
 *
 * Redrawn from the Mermaid source with the Diagram Design skill; the inline SVG
 * is theme-aware through the `.architecture-diagram` tokens in `global.css`.
 * No client-side rendering.
 */
---

<div class="architecture-diagram">
  <svg
    viewBox="0 0 960 600"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="mixar-architecture-title mixar-architecture-desc"
  >
    <title id="mixar-architecture-title">Mixar architecture</title>
    <desc id="mixar-architecture-desc"
      >Flutter opens one event stream from BusTransport and sends commands over
      three FRB transports; every engine, library and controller event is one
      typed enum on a single bus, and MIDI hardware drives the controller
      crate.</desc
    >
    <defs>
      <marker id="arrow" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto"
        ><polygon points="0 0, 8 3, 0 6" fill="var(--muted)"></polygon
      ></marker>
      <marker id="arrow-back" markerWidth="8" markerHeight="6" refX="1" refY="3" orient="auto"
        ><polygon points="8 0, 0 3, 8 6" fill="var(--muted)"></polygon
      ></marker>
    </defs>

    <rect width="100%" height="100%" fill="var(--paper)"></rect>

    <!-- Zone: host-flutter (drawn before arrows and nodes) -->
    <rect
      x="100"
      y="128"
      width="720"
      height="144"
      rx="8"
      fill="var(--zone-fill)"
      stroke="var(--zone-border)"
      stroke-width="0.8"></rect>
    <rect x="116" y="132" width="96" height="12" rx="2" fill="var(--paper)"></rect>
    <text
      x="164"
      y="141"
      fill="var(--zone-label)"
      font-size="7"
      class="dg-mono"
      text-anchor="middle"
      letter-spacing="0.14em">HOST-FLUTTER</text
    >

    <!-- Arrows (behind the boxes) -->
    <!-- UI -> BusTransport: the one event stream -->
    <path
      d="M420,104 V132 Q420,140 412,140 H298 Q290,140 290,148 V176"
      fill="none"
      stroke="var(--muted)"
      stroke-width="1.2"
      marker-start="url(#arrow-back)"
      marker-end="url(#arrow)"></path>
    <!-- UI -> domain transports: commands -->
    <path
      d="M540,104 V132 Q540,140 548,140 H622 Q630,140 630,148 V176"
      fill="none"
      stroke="var(--muted)"
      stroke-width="1.2"
      marker-start="url(#arrow-back)"
      marker-end="url(#arrow)"></path>
    <!-- MIDI hardware -> controller crate (midir), down the outside of the zone -->
    <path
      d="M830,104 V452"
      fill="none"
      stroke="var(--muted)"
      stroke-width="1.2"
      marker-start="url(#arrow-back)"
      marker-end="url(#arrow)"></path>
    <!-- BusTransport -> bus: subscribes to every event -->
    <path
      d="M290,232 V260 Q290,268 298,268 H412 Q420,268 420,276 V316"
      fill="none"
      stroke="var(--muted)"
      stroke-width="1.2"
      marker-start="url(#arrow-back)"
      marker-end="url(#arrow)"></path>
    <!-- domain transports -> bus (cmd/evt) -->
    <path
      d="M630,232 V260 Q630,268 622,268 H548 Q540,268 540,276 V316"
      fill="none"
      stroke="var(--muted)"
      stroke-width="1.2"
      marker-start="url(#arrow-back)"
      marker-end="url(#arrow)"></path>
    <!-- bus -> domains (cmd/evt) -->
    <path
      d="M390,396 V412 Q390,420 382,420 H188 Q180,420 180,428 V452"
      fill="none"
      stroke="var(--muted)"
      stroke-width="1.2"
      marker-start="url(#arrow-back)"
      marker-end="url(#arrow)"></path>
    <line
      x1="480"
      y1="396"
      x2="480"
      y2="452"
      stroke="var(--muted)"
      stroke-width="1.2"
      marker-start="url(#arrow-back)"
      marker-end="url(#arrow)"></line>
    <path
      d="M570,396 V412 Q570,420 578,420 H772 Q780,420 780,428 V452"
      fill="none"
      stroke="var(--muted)"
      stroke-width="1.2"
      marker-start="url(#arrow-back)"
      marker-end="url(#arrow)"></path>

    <!-- Arrow labels (opaque masks, 6-10px off the stroke) -->
    <rect x="428" y="110" width="60" height="12" rx="2" fill="var(--paper)"></rect>
    <text x="458" y="119" fill="var(--muted)" font-size="8" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">1 STREAM</text>

    <rect x="548" y="110" width="36" height="12" rx="2" fill="var(--paper)"></rect>
    <text x="566" y="119" fill="var(--muted)" font-size="8" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">CMD</text>

    <rect x="838" y="292" width="40" height="12" rx="2" fill="var(--paper)"></rect>
    <text x="858" y="301" fill="var(--muted)" font-size="8" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">MIDI</text>

    <rect x="298" y="240" width="68" height="12" rx="2" fill="var(--paper)"></rect>
    <text x="332" y="249" fill="var(--muted)" font-size="8" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">ALL EVENTS</text>

    <rect x="638" y="240" width="56" height="12" rx="2" fill="var(--paper)"></rect>
    <text x="666" y="249" fill="var(--muted)" font-size="8" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">CMD/EVT</text>

    <rect x="257" y="428" width="56" height="12" rx="2" fill="var(--paper)"></rect>
    <text x="285" y="437" fill="var(--muted)" font-size="8" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">CMD/EVT</text>

    <rect x="488" y="412" width="56" height="12" rx="2" fill="var(--paper)"></rect>
    <text x="516" y="421" fill="var(--muted)" font-size="8" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">CMD/EVT</text>

    <rect x="647" y="428" width="56" height="12" rx="2" fill="var(--paper)"></rect>
    <text x="675" y="437" fill="var(--muted)" font-size="8" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">CMD/EVT</text>

    <!-- Node: Flutter UI -->
    <rect x="300" y="48" width="360" height="56" rx="6" fill="var(--paper)"></rect>
    <rect
      x="300"
      y="48"
      width="360"
      height="56"
      rx="6"
      fill="var(--input-fill)"
      stroke="var(--soft)"
      stroke-width="1"></rect>
    <rect
      x="308"
      y="54"
      width="30"
      height="12"
      rx="2"
      fill="transparent"
      stroke="var(--tagstroke-soft)"
      stroke-width="0.8"></rect>
    <text x="323" y="63" fill="var(--soft)" font-size="7" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">APP</text>
    <text x="480" y="74" fill="var(--ink)" font-size="12" font-weight="600" class="dg-name" text-anchor="middle">Flutter UI</text>
    <text x="480" y="90" fill="var(--muted)" font-size="9" class="dg-mono" text-anchor="middle">gui-flutter</text>

    <!-- Node: MIDI Hardware -->
    <rect x="740" y="48" width="180" height="56" rx="6" fill="var(--paper)"></rect>
    <rect
      x="740"
      y="48"
      width="180"
      height="56"
      rx="6"
      fill="var(--external-fill)"
      stroke="var(--external-stroke)"
      stroke-width="1"></rect>
    <rect
      x="748"
      y="54"
      width="30"
      height="12"
      rx="2"
      fill="transparent"
      stroke="var(--external-stroke)"
      stroke-width="0.8"></rect>
    <text x="763" y="63" fill="var(--soft)" font-size="7" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">EXT</text>
    <text x="830" y="74" fill="var(--ink)" font-size="12" font-weight="600" class="dg-name" text-anchor="middle">MIDI Hardware</text>
    <text x="830" y="90" fill="var(--muted)" font-size="9" class="dg-mono" text-anchor="middle">external device</text>

    <!-- Node: BusTransport -->
    <rect x="140" y="176" width="300" height="56" rx="6" fill="var(--paper)"></rect>
    <rect x="140" y="176" width="300" height="56" rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="1"></rect>
    <rect
      x="148"
      y="182"
      width="30"
      height="12"
      rx="2"
      fill="transparent"
      stroke="var(--tagstroke-ink)"
      stroke-width="0.8"></rect>
    <text x="163" y="191" fill="var(--soft)" font-size="7" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">BRG</text>
    <text x="290" y="202" fill="var(--ink)" font-size="12" font-weight="600" class="dg-name" text-anchor="middle">BusTransport</text>
    <text x="290" y="218" fill="var(--muted)" font-size="9" class="dg-mono" text-anchor="middle">one stream · fan-out</text>

    <!-- Node: domain transports -->
    <rect x="480" y="176" width="300" height="56" rx="6" fill="var(--paper)"></rect>
    <rect x="480" y="176" width="300" height="56" rx="6" fill="var(--card)" stroke="var(--ink)" stroke-width="1"></rect>
    <rect
      x="488"
      y="182"
      width="30"
      height="12"
      rx="2"
      fill="transparent"
      stroke="var(--tagstroke-ink)"
      stroke-width="0.8"></rect>
    <text x="503" y="191" fill="var(--soft)" font-size="7" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">BRG</text>
    <text x="630" y="202" fill="var(--ink)" font-size="12" font-weight="600" class="dg-name" text-anchor="middle">Domain transports</text>
    <text x="630" y="218" fill="var(--muted)" font-size="9" class="dg-mono" text-anchor="middle">engine · library · controller</text>

    <!-- Node: event bus (focal) -->
    <rect x="300" y="316" width="360" height="80" rx="6" fill="var(--paper)"></rect>
    <rect
      x="300"
      y="316"
      width="360"
      height="80"
      rx="6"
      fill="var(--accent-tint)"
      stroke="var(--accent)"
      stroke-width="1"></rect>
    <rect
      x="308"
      y="322"
      width="30"
      height="12"
      rx="2"
      fill="transparent"
      stroke="var(--tagstroke-accent)"
      stroke-width="0.8"></rect>
    <text x="323" y="331" fill="var(--accent)" font-size="7" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">BUS</text>
    <text x="480" y="352" fill="var(--ink)" font-size="12" font-weight="600" class="dg-name" text-anchor="middle">Event bus</text>
    <text x="480" y="370" fill="var(--muted)" font-size="9" class="dg-mono" text-anchor="middle">event-bus · bus-api</text>

    <!-- Node: Engine -->
    <rect x="40" y="452" width="280" height="72" rx="6" fill="var(--paper)"></rect>
    <rect
      x="40"
      y="452"
      width="280"
      height="72"
      rx="6"
      fill="var(--store-fill)"
      stroke="var(--muted)"
      stroke-width="1"></rect>
    <rect
      x="48"
      y="458"
      width="30"
      height="12"
      rx="2"
      fill="transparent"
      stroke="var(--tagstroke-ink)"
      stroke-width="0.8"></rect>
    <text x="63" y="467" fill="var(--soft)" font-size="7" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">CORE</text>
    <text x="180" y="484" fill="var(--ink)" font-size="12" font-weight="600" class="dg-name" text-anchor="middle">Engine</text>
    <text x="180" y="502" fill="var(--muted)" font-size="9" class="dg-mono" text-anchor="middle">engine-core · engine-dsp</text>

    <!-- Node: Library -->
    <rect x="340" y="452" width="280" height="72" rx="6" fill="var(--paper)"></rect>
    <rect
      x="340"
      y="452"
      width="280"
      height="72"
      rx="6"
      fill="var(--store-fill)"
      stroke="var(--muted)"
      stroke-width="1"></rect>
    <rect
      x="348"
      y="458"
      width="30"
      height="12"
      rx="2"
      fill="transparent"
      stroke="var(--tagstroke-ink)"
      stroke-width="0.8"></rect>
    <text x="363" y="467" fill="var(--soft)" font-size="7" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">LIB</text>
    <text x="480" y="484" fill="var(--ink)" font-size="12" font-weight="600" class="dg-name" text-anchor="middle">Library</text>
    <text x="480" y="502" fill="var(--muted)" font-size="9" class="dg-mono" text-anchor="middle">library-core · analyzer</text>

    <!-- Node: Controller -->
    <rect x="640" y="452" width="280" height="72" rx="6" fill="var(--paper)"></rect>
    <rect
      x="640"
      y="452"
      width="280"
      height="72"
      rx="6"
      fill="var(--store-fill)"
      stroke="var(--muted)"
      stroke-width="1"></rect>
    <rect
      x="648"
      y="458"
      width="30"
      height="12"
      rx="2"
      fill="transparent"
      stroke="var(--tagstroke-ink)"
      stroke-width="0.8"></rect>
    <text x="663" y="467" fill="var(--soft)" font-size="7" class="dg-mono" text-anchor="middle" letter-spacing="0.08em">CTL</text>
    <text x="780" y="484" fill="var(--ink)" font-size="12" font-weight="600" class="dg-name" text-anchor="middle">Controller</text>
    <text x="780" y="502" fill="var(--muted)" font-size="9" class="dg-mono" text-anchor="middle">controller · midir</text>

    <!-- Legend strip -->
    <line x1="40" y1="552" x2="920" y2="552" stroke="var(--rule)" stroke-width="0.8"></line>
    <text x="40" y="568" fill="var(--muted)" font-size="8" class="dg-mono" letter-spacing="0.18em">LEGEND</text>

    <rect x="40" y="584" width="14" height="10" rx="2" fill="var(--accent-tint)" stroke="var(--accent)" stroke-width="1"></rect>
    <text x="62" y="592" fill="var(--muted)" font-size="8.5" class="dg-name">Focal hub</text>

    <rect x="190" y="584" width="14" height="10" rx="2" fill="var(--card)" stroke="var(--ink)" stroke-width="1"></rect>
    <text x="212" y="592" fill="var(--muted)" font-size="8.5" class="dg-name">Transport</text>

    <rect x="340" y="584" width="14" height="10" rx="2" fill="var(--store-fill)" stroke="var(--muted)" stroke-width="1"></rect>
    <text x="362" y="592" fill="var(--muted)" font-size="8.5" class="dg-name">Rust domain</text>

    <rect x="490" y="584" width="14" height="10" rx="2" fill="var(--input-fill)" stroke="var(--soft)" stroke-width="1"></rect>
    <text x="512" y="592" fill="var(--muted)" font-size="8.5" class="dg-name">App / UI</text>

    <rect x="640" y="584" width="14" height="10" rx="2" fill="var(--external-fill)" stroke="var(--external-stroke)" stroke-width="1"></rect>
    <text x="662" y="592" fill="var(--muted)" font-size="8.5" class="dg-name">External</text>

    <line
      x1="790"
      y1="589"
      x2="826"
      y2="589"
      stroke="var(--muted)"
      stroke-width="1.2"
      marker-start="url(#arrow-back)"
      marker-end="url(#arrow)"></line>
    <text x="834" y="592" fill="var(--muted)" font-size="8.5" class="dg-name">cmd/evt</text>
  </svg>
</div>
