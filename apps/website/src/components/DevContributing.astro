---
import { GITHUB_REPO } from "../consts";
---

<section class="section contributing">
  <div class="cta-panel">
    <h2>Contributing</h2>
    <p>
      Issues and pull requests are welcome. The repo uses lefthook for pre-commit format and lint on
      staged Rust and Dart files. Run <code>npx moon ci --base main</code> locally to mimic CI.
    </p>
    <a class="btn btn-primary" href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">
      Open the repository
    </a>
  </div>
</section>

<style>
  .contributing {
    padding-bottom: 6rem;
  }

  .contributing code {
    font-family: ui-monospace, "Cascadia Code", "SF Mono", monospace;
    font-size: 0.85em;
  }
</style>
