---
interface Props {
  iconTone?: "deck-a" | "deck-b" | "accent";
  title: string;
  revealIndex?: number;
}

const { iconTone = "accent", title, revealIndex } = Astro.props;

const iconTones = {
  "deck-a": "bg-green-500/15 text-deck-a",
  "deck-b": "bg-sky-500/15 text-deck-b",
  accent: "bg-accent-dim text-accent",
};

const cardTones = {
  "deck-a": "hover:border-deck-a/40",
  "deck-b": "hover:border-deck-b/40",
  accent: "hover:border-accent/40",
};

const revealStyle =
  revealIndex === undefined ? undefined : `--reveal-delay: ${revealIndex * 100}ms`;
---

<article
  data-reveal
  style={revealStyle}
  class:list={[
    "rounded-xl border border-border bg-bg-card p-7 transition-[border-color,transform] hover:-translate-y-0.5 sm:p-8",
    cardTones[iconTone],
  ]}
>
  <div
    class:list={[
      "mb-5 flex h-14 w-14 items-center justify-center rounded-xl [&_svg]:size-6",
      iconTones[iconTone],
    ]}
    aria-hidden="true"
  >
    <slot name="icon" />
  </div>
  <h3 class="mb-2 font-serif text-xl font-bold leading-snug tracking-tight">{title}</h3>
  <p class="text-[0.9375rem] leading-relaxed text-muted">
    <slot />
  </p>
</article>
