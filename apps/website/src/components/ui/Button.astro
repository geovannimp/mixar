---
import type { Placement } from "../../scripts/analytics-events";

interface Props {
  href: string;
  variant?: "primary" | "secondary";
  external?: boolean;
  class?: string;
  /**
   * Analytics placement bucket. Rendered as `data-placement` and read by the
   * delegated listener in `src/scripts/analytics.ts`. Astro drops the attribute
   * when this is undefined.
   *
   * Typed as the closed `Placement` set for editor feedback. Note that `tsc`
   * does not parse .astro files, so the set is actually enforced against the
   * component sources by `src/scripts/analytics-events.test.ts`.
   */
  placement?: Placement;
}

const {
  href,
  variant = "primary",
  external = false,
  class: className,
  placement,
} = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 rounded-full px-5.5 py-3 text-[0.9375rem] font-semibold transition hover:-translate-y-px active:translate-y-0";
const variants = {
  primary: "bg-accent text-white hover:bg-accent-hover dark:bg-accent dark:text-teal-950 dark:hover:bg-accent-hover",
  secondary:
    "border border-border bg-transparent text-fg hover:border-border-hover hover:bg-accent-dim",
};
---

<a
  href={href}
  class:list={[base, variants[variant], className]}
  data-placement={placement}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <slot />
  {external && <span class="sr-only"> (opens in new tab)</span>}
</a>
