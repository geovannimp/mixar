---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<p
  class:list={[
    "mb-5 inline-flex items-center gap-1.5 rounded-full border border-border bg-accent-dim px-3 py-1.5 text-[length:var(--font-size-caption)] font-medium text-accent",
    className,
  ]}
>
  <slot />
</p>
