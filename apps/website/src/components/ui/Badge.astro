---
interface Props {
  variant?: "default" | "dev";
  class?: string;
}

const { variant = "default", class: className } = Astro.props;

const base =
  "mb-5 inline-block rounded-full border px-3 py-1.5 text-[0.8125rem] font-medium";
const variants = {
  default: "border-border bg-accent-dim text-accent",
  dev: "border-amber-400/40 bg-amber-400/15 text-amber-700 dark:border-amber-400/35 dark:bg-amber-400/12 dark:text-amber-300",
};
---

<p class:list={[base, variants[variant], className]}>
  <slot />
</p>
