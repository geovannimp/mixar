---
interface Props {
  variant?: "default" | "dev";
  class?: string;
}

const { variant = "default", class: className } = Astro.props;

const base =
  "mb-5 inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-[length:var(--font-size-caption)] font-medium";
const variants = {
  default: "border-border bg-accent-dim text-accent",
  dev: "border-amber-500/40 bg-amber-400/15 text-amber-900 dark:border-amber-400/35 dark:bg-amber-400/12 dark:text-amber-200",
};
---

<p class:list={[base, variants[variant], className]}>
  <slot />
</p>
