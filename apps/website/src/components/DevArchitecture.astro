---
import { TECH_SPEC_URL } from "../consts";
import MermaidDiagram from "./MermaidDiagram.astro";
import SectionHeader from "./ui/SectionHeader.astro";

const chart = `graph TB
  lib["Library / AudioSource"] -->|load PCM| eng["Engine: decks + mixer"]
  eng --> prod["Producer thread"]
  prod --> ring["Ring buffer"]
  ring --> cb["Audio callback"]`;
---

<section class="bg-bg-elevated px-6 py-20">
  <div class="mx-auto max-w-content">
    <SectionHeader
      title="Architecture"
      description="A producer thread runs DSP and writes interleaved stereo into a lock-free ring buffer. The audio callback only consumes. No allocations on the real-time thread."
    />
    <MermaidDiagram chart={chart} />
    <p class="mt-6 text-center text-[0.9375rem]">
      <a
        class="font-semibold text-accent hover:text-accent-hover"
        href={TECH_SPEC_URL}
        target="_blank"
        rel="noopener noreferrer">Read the full tech spec on GitHub</a
      >
    </p>
  </div>
</section>
