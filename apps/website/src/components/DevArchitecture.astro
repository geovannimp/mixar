---
import { TECH_SPEC_URL } from "../consts";
import { ExternalLink, GitBranch } from "@lucide/astro";
import ArchitectureDiagram from "./ArchitectureDiagram.astro";
import Button from "./ui/Button.astro";
import SectionHeader from "./ui/SectionHeader.astro";

const iconProps = { size: 18, "stroke-width": 2 };
---

<section class="border-y border-border bg-bg-elevated px-section py-24 lg:py-28">
  <div class="mx-auto max-w-content">
    <SectionHeader
      title="Architecture"
      description="UI, controllers, and engine stay in sync over cmd/evt buses. Transports move MessagePack in both directions, with a focused Rust crate behind each domain."
    >
      <GitBranch
        slot="icon"
        class="size-20 shrink-0 text-accent"
        stroke-width={1.75}
        aria-hidden="true"
      />
    </SectionHeader>
    <div class="rounded-xl border border-border bg-bg-card p-4 sm:p-8">
      <ArchitectureDiagram />
    </div>
    <div class="mt-8 text-center">
      <Button href={TECH_SPEC_URL} external variant="secondary" placement="dev_architecture" class="px-7 py-3.5 text-base">
        <ExternalLink {...iconProps} aria-hidden="true" />
        Read the full tech spec
      </Button>
    </div>
  </div>
</section>
