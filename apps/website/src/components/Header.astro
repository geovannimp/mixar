---
import { GITHUB_REPO } from "../consts";

interface Props {
  currentPage?: "home" | "developers";
}

const { currentPage = "home" } = Astro.props;
---

<header class="site-header">
  <nav class="nav" aria-label="Primary">
    <a class="nav-brand" href="/">
      <img src="/mixar-logo.png" alt="Mixar" width="120" height="28" />
    </a>
    <div class="nav-end">
      <div class="nav-links">
        <a href={currentPage === "home" ? "#features" : "/#features"}>Features</a>
        <a
          href={currentPage === "home" ? "#developers" : "/developers"}
          aria-current={currentPage === "developers" ? "page" : undefined}
        >
          Developers
        </a>
        <a href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">
          GitHub
        </a>
      </div>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle light and dark theme">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<style>
  .nav-brand img {
    height: 1.75rem;
    width: auto;
  }

  [data-theme="light"] .nav-brand img {
    filter: invert(1);
  }
</style>
