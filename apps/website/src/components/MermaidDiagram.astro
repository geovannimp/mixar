---
import { renderMermaid } from "beautiful-mermaid";

interface Props {
  chart: string;
}

const { chart } = Astro.props;

const svg = await renderMermaid(chart, {
  bg: "var(--bg-elevated)",
  fg: "var(--text)",
  accent: "var(--accent)",
  muted: "var(--text-muted)",
  transparent: true,
  font: '"Outfit Variable", ui-sans-serif, system-ui, sans-serif',
});
---

<div class="flex justify-center overflow-x-auto py-2 [&_svg]:h-auto [&_svg]:max-w-full" set:html={svg} />
