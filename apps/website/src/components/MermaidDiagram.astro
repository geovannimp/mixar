---
import { renderMermaid } from "beautiful-mermaid";

interface Props {
  chart: string;
}

const { chart } = Astro.props;

const svg = await renderMermaid(chart, {
  bg: "var(--bg-elevated)",
  fg: "var(--text)",
  accent: "var(--accent)",
  muted: "var(--text-muted)",
  transparent: true,
  font: '"DM Sans", system-ui, sans-serif',
});
---

<div class="mermaid-diagram" set:html={svg} />

<style>
  .mermaid-diagram {
    display: flex;
    justify-content: center;
    overflow-x: auto;
    padding: 0.5rem 0;
  }

  .mermaid-diagram :global(svg) {
    max-width: 100%;
    height: auto;
  }
</style>
