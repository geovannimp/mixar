---
import { GITHUB_REPO } from "../consts";
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";
---

<section class="px-6 pt-16 pb-12">
  <div class="mx-auto max-w-[640px] text-center">
    <Badge>Open source</Badge>
    <h1 class="mb-4 text-[clamp(2rem,4vw,2.75rem)] font-bold tracking-tight">Build with us</h1>
    <p class="mb-7 text-[1.0625rem] text-muted">
      Mixar is a modular Rust audio engine with a Flutter UI. Inspect the code, run it locally, and
      help shape the future of open DJ software.
    </p>
    <Button href={GITHUB_REPO} external>Star on GitHub</Button>
  </div>
</section>
