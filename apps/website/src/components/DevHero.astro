---
import { GITHUB_REPO } from "../consts";
import { Star } from "@lucide/astro";
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";

const iconProps = { size: 16, "stroke-width": 2 };
---

<section class="px-6 py-16 lg:py-20">
  <div class="mx-auto max-w-[640px] text-center">
    <Badge>Open source</Badge>
    <h1 class="mb-4 text-[clamp(2rem,4vw,2.75rem)] leading-[1.1] font-bold tracking-tight">Build with us</h1>
    <p class="mb-6 text-[1.0625rem] leading-relaxed text-muted">
      Mixar is a modular Rust audio engine with a Flutter UI. Inspect the code, run it locally, and
      help shape the future of open DJ software.
    </p>
    <Button href={GITHUB_REPO} external>
      <Star {...iconProps} aria-hidden="true" />
      Star on GitHub
    </Button>
  </div>
</section>
