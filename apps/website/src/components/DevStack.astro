---
import History from "../icons/History.astro";
import { Activity, Cable, Layers, PanelTop, Split, Volume2 } from "@lucide/astro";
import FeatureCard from "./ui/FeatureCard.astro";
import SectionHeader from "./ui/SectionHeader.astro";

const iconProps = { size: 24, "stroke-width": 2 };
---

<section class="relative overflow-hidden px-section py-24 lg:py-28">
  <SectionHeader
    eyebrow="01 / Stack"
    title="Stack"
    description="Engine-first boundaries between audio, library, and UI."
  >
    <Layers slot="icon" class="size-20 shrink-0 text-accent" stroke-width={1.75} aria-hidden="true" />
  </SectionHeader>
  <div
    class="relative mx-auto grid max-w-content gap-6 sm:grid-cols-2 lg:grid-cols-3"
    data-reveal-group
  >
    <!-- Ghost word behind the cards (Kurosawa outline layering), same as the
         landing Features grid; draws itself in on entry. -->
    <svg
      class="ghost-word pointer-events-none absolute left-1/2 z-0 block w-[90vw] -translate-x-1/2"
      viewBox="0 0 1000 290"
      focusable="false"
      aria-hidden="true"
    >
      <text class="ghost-word-text" x="500" y="250" text-anchor="middle" font-size="315">
        STACK
      </text>
    </svg>
    <FeatureCard revealIndex={0} iconTone="deck-a" title="Rust engine">
      <Volume2 slot="icon" {...iconProps} />
      Real-time audio and mixing in Rust. The audio callback allocates nothing, so timing
      stays predictable under load.
    </FeatureCard>
    <FeatureCard revealIndex={1} iconTone="deck-b" title="Flutter UI">
      <PanelTop slot="icon" {...iconProps} />
      Decks, waveforms, and mixer chrome in one UI codebase for desktop today and mobile
      targets next.
    </FeatureCard>
    <FeatureCard revealIndex={2} iconTone="accent" title="Async buses">
      <History slot="icon" {...iconProps} />
      The UI talks to the engine, library, and controllers over async message buses, so
      engine code never runs on the UI thread.
    </FeatureCard>
    <FeatureCard revealIndex={3} iconTone="accent" title="Stem separation">
      <Split slot="icon" {...iconProps} />
      HTDemucs splits a track into drums, bass, other, and vocals offline. GPU (WebGPU)
      when available, CPU otherwise, with no cloud round-trip.
    </FeatureCard>
    <FeatureCard revealIndex={4} iconTone="deck-a" title="Offline analysis">
      <Activity slot="icon" {...iconProps} />
      BPM, key, loudness, artwork, and waveforms are computed locally and cached in a
      SQLite library.
    </FeatureCard>
    <FeatureCard revealIndex={5} iconTone="deck-b" title="Pluggable backends">
      <Cable slot="icon" {...iconProps} />
      CPAL/PipeWire on Linux, or a null backend for tests, chosen at runtime behind one
      trait.
    </FeatureCard>
  </div>
</section>

<script>
 import { drawGhostWordOnEnter } from "../lib/ghost-word";
 drawGhostWordOnEnter();
</script>
