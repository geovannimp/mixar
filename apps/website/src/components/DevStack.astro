---
import History from "../icons/History.astro";
import { PanelTop, Volume2 } from "@lucide/astro";
import FeatureCard from "./ui/FeatureCard.astro";
import SectionHeader from "./ui/SectionHeader.astro";

const iconProps = { size: 16, "stroke-width": 2 };
---

<section class="px-6 py-20">
  <SectionHeader
    title="Stack"
    description="Engine-first design with clear boundaries between audio, library, and UI."
  />
  <div class="mx-auto grid max-w-content gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <FeatureCard title="Rust engine">
      <Volume2 slot="icon" {...iconProps} />
      Real-time audio, mixing, library I/O, and analysis. Rust gives predictable performance and
      memory safety on the audio path.
    </FeatureCard>
    <FeatureCard title="Flutter UI">
      <PanelTop slot="icon" {...iconProps} />
      Cross-platform decks, waveforms, and mixer chrome. Flutter keeps one UI codebase for desktop
      and mobile targets.
    </FeatureCard>
    <FeatureCard title="Async buses">
      <History slot="icon" {...iconProps} />
      The UI talks to the engine, library, and controllers through async message buses instead of
      calling engine code on the UI thread.
    </FeatureCard>
  </div>
</section>
