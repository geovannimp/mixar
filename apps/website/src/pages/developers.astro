---
import BaseLayout from "../layouts/BaseLayout.astro";
import DevHero from "../components/DevHero.astro";
import DevStack from "../components/DevStack.astro";
import DevArchitecture from "../components/DevArchitecture.astro";
import DevDocs from "../components/DevDocs.astro";
import Ticker from "../components/Ticker.astro";

/** Divider vocabulary for the developer page — mirrors the landing tickers. */
const stackTicker = [
  "Rust engine",
  "Flutter UI",
  "Async buses",
  "GPL-3.0",
  "CPAL",
  "MessagePack",
  "Offline analysis",
] as const;
---

<BaseLayout
  title="Developers"
  description="Build with Mixar: Rust audio engine, Flutter UI, and GPL-3.0 DJ software you can fork."
  currentPage="developers"
>
  <DevHero />
  <Ticker items={stackTicker} />
  <DevStack />
  <DevArchitecture />
  <DevDocs />
</BaseLayout>
