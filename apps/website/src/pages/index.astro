---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Ticker from "../components/Ticker.astro";
import Features from "../components/Features.astro";
import Stems from "../components/Stems.astro";
import Pricing from "../components/Pricing.astro";
import Platforms from "../components/Platforms.astro";
import DevelopersSection from "../components/DevelopersSection.astro";

/** Repeated divider vocabulary — the words double as on-page copy elsewhere. */
const featureTicker = [
  "Dual decks",
  "Full mixer",
  "Hot cues",
  "Loops",
  "NI Stems",
  "MIDI mapping",
  "GPL-3.0",
] as const;
---

<BaseLayout
  title="Mixar"
  description="Free, open-source DJ software. Dual decks, hot cues, loops, and NI Stems. Download pre-release builds from GitHub."
  currentPage="home"
>
  <Hero />
  <Ticker items={featureTicker} />
  <Features />
  <Stems />
  <Pricing />
  <Platforms />
  <DevelopersSection />
</BaseLayout>
