---
import BaseLayout from "../../layouts/BaseLayout.astro";
import data from "blume:data";
import { ArrowRight, BookOpen } from "@lucide/astro";

/**
 * The docs landing page: the two audiences and the topics under them, built
 * from the navigation tree Blume infers from the content.
 */

interface NavNode {
  kind: "page" | "group";
  label: string;
  route?: string;
  description?: string;
  children?: NavNode[];
}

/** The blurb shown above each audience's topics. */
const AUDIENCE_DESCRIPTIONS: Record<string, string> = {
  Users: "Using Mixar to play and organize music.",
  Developers: "Building, extending, and integrating with Mixar.",
};

/** Every page under a node, the node's own landing page included. */
function pageCount(node: NavNode): number {
  if (node.kind === "page") return 1;
  return (node.children ?? []).reduce((sum, child) => sum + pageCount(child), 0);
}

/** The page a group is served at: the child whose route is the group's own. */
function landingPage(node: NavNode): NavNode | undefined {
  const children = node.children ?? [];
  return (
    children.find((child) => child.kind === "page" && child.route === node.route) ??
    children.find((child) => child.kind === "page")
  );
}

const sidebar = (data.navigation?.sidebar ?? []) as NavNode[];

const audiences = sidebar
  .filter((node) => node.kind === "group")
  .map((audience) => ({
    label: audience.label,
    description: AUDIENCE_DESCRIPTIONS[audience.label] ?? "",
    topics: (audience.children ?? [])
      .filter((child) => child.kind === "group")
      .map((topic) => {
        const landing = landingPage(topic);
        return {
          label: topic.label,
          href: topic.route ?? landing?.route ?? "",
          description: landing?.description ?? "",
          count: pageCount(topic),
        };
      }),
  }));

const total = sidebar.reduce((sum, node) => sum + pageCount(node), 0);
---

<BaseLayout
  title="Documentation"
  description="Mixar documentation for developers and users: MIDI controller mappings, the mapping bundle format, and more."
  currentPage="docs"
>
  <section class="mx-auto max-w-content px-section py-16 lg:py-20">
    <header class="mb-12 max-w-[52ch]">
      <BookOpen class="mb-5 size-12 text-accent" stroke-width={1.75} aria-hidden="true" />
      <h1
        class="m-0 font-serif text-[clamp(2.25rem,6vw,3.25rem)] font-bold leading-[1.05] tracking-[-0.03em]"
      >
        Documentation
      </h1>
      <p class="mt-4 text-[1.125rem] leading-relaxed text-muted lg:text-xl">
        Guides for developers building with and extending Mixar, and for users playing with it.
        {total} page{total === 1 ? "" : "s"} so far.
      </p>
    </header>

    <div class="grid gap-12">
      {
        audiences.map((audience) => (
          <section>
            <h2 class="m-0 font-serif text-[1.5rem] font-bold tracking-[-0.02em]">
              {audience.label}
            </h2>
            <p class="mt-1 text-[0.9375rem] text-muted">{audience.description}</p>

            {audience.topics.length > 0 ? (
              <div class="mt-5 grid gap-6 sm:grid-cols-2">
                {audience.topics.map((topic) => (
                  <a
                    href={topic.href}
                    class="group flex flex-col rounded-2xl border border-border bg-bg-card p-6 transition hover:border-border-hover hover:bg-accent-dim"
                  >
                    <div class="flex items-center justify-between gap-4">
                      <h3 class="m-0 font-serif text-[1.25rem] font-bold tracking-[-0.02em]">
                        {topic.label}
                      </h3>
                      <ArrowRight
                        class="size-5 shrink-0 text-muted transition group-hover:translate-x-0.5 group-hover:text-accent"
                        aria-hidden="true"
                      />
                    </div>
                    <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">
                      {topic.description}
                    </p>
                    <span class="mt-5 text-[0.8125rem] font-medium uppercase tracking-wide text-muted">
                      {topic.count} page{topic.count === 1 ? "" : "s"}
                    </span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="mt-5 rounded-2xl border border-dashed border-border bg-bg-elevated px-6 py-8 text-[0.9375rem] text-muted">
                Guides are on the way.
              </p>
            )}
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
