---
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import Callout from "../../components/docs/Callout.astro";
import DocsTable from "../../components/docs/DocsTable.astro";
import { docSlug, entriesForTopic, getDocs, type DocEntry } from "../../lib/docs";

export async function getStaticPaths() {
  const { docs } = await getDocs();
  // The overview entry maps to the topic root (`/docs/<category>/<topic>`); an
  // empty slug is never emitted, so this never collides with `docs/index.astro`.
  return docs.map((entry) => ({
    params: { slug: docSlug(entry.id) },
    props: { entry },
  }));
}

interface Props {
  entry: DocEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const { categories } = await getDocs();
const siblings = entriesForTopic(categories, entry.id);
const index = siblings.findIndex((sibling) => sibling.id === entry.id);
const prev = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  currentId={entry.id}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content components={{ Callout, table: DocsTable }} />
</DocsLayout>
