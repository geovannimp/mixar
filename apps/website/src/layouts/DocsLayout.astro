---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import DocsNav from "../components/docs/DocsNav.astro";
import { docPath, getDocs, type DocEntry } from "../lib/docs";
import { ArrowLeft, ArrowRight } from "@lucide/astro";

interface Props {
  title: string;
  description: string;
  currentId: string;
  headings: MarkdownHeading[];
  prev?: DocEntry;
  next?: DocEntry;
}

const { title, description, currentId, headings, prev, next } = Astro.props;

const { categories } = await getDocs();
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const linkClass =
  "flex items-center gap-2 rounded-xl border border-border bg-bg-card px-4 py-3 text-[0.9375rem] transition hover:border-border-hover";

// Full class literals so Tailwind extracts them; the xl template is applied
// only when the page has a TOC to place in the third column.
const gridClass = "lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-12";
const gridWithTocClass = "xl:grid-cols-[16rem_minmax(0,1fr)_14rem]";
---

<BaseLayout title={title} description={description} currentPage="docs">
  <div class="mx-auto max-w-content px-section py-10 lg:py-14">
    <div class:list={[gridClass, toc.length > 0 && gridWithTocClass]}>
      <aside class="mb-8 lg:sticky lg:top-20 lg:mb-0 lg:h-[calc(100vh-6rem)] lg:overflow-y-auto lg:pr-2">
        <details
          id="docs-nav"
          open
          class="rounded-xl border border-border bg-bg-elevated px-4 py-3 lg:border-0 lg:bg-transparent lg:p-0"
        >
          <summary class="cursor-pointer font-semibold text-fg lg:hidden">Documentation</summary>
          <div class="pt-4 lg:pt-0">
            <DocsNav categories={categories} currentId={currentId} />
          </div>
        </details>
      </aside>

      <div class="min-w-0">
        <nav
          aria-label="Breadcrumb"
          class="mb-3 text-[0.8125rem] font-medium uppercase tracking-wide text-muted"
        >
          <a class="transition hover:text-accent" href="/docs">Docs</a>
        </nav>

        <article class="docs-prose max-w-[48rem]">
          <header class="mb-8 border-b border-border pb-6">
            <h1
              class="m-0 font-serif text-[clamp(2rem,5vw,2.75rem)] font-bold leading-[1.1] tracking-[-0.03em]"
            >
              {title}
            </h1>
            <p class="mt-3 text-[1.0625rem] leading-relaxed text-muted">{description}</p>
          </header>
          <slot />
        </article>

        <nav aria-label="Pagination" class="mt-12 grid max-w-[48rem] gap-3 sm:grid-cols-2">
          {
            prev ? (
              <a class={linkClass} href={docPath(prev.id)}>
                <ArrowLeft class="size-4 shrink-0 text-muted" aria-hidden="true" />
                <span class="min-w-0">
                  <span class="block text-[0.75rem] uppercase tracking-wide text-muted">Previous</span>
                  <span class="block truncate font-semibold">{prev.data.title}</span>
                </span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a class:list={[linkClass, "sm:col-start-2 sm:justify-end sm:text-right"]} href={docPath(next.id)}>
                <span class="min-w-0">
                  <span class="block text-[0.75rem] uppercase tracking-wide text-muted">Next</span>
                  <span class="block truncate font-semibold">{next.data.title}</span>
                </span>
                <ArrowRight class="size-4 shrink-0 text-muted" aria-hidden="true" />
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </div>

      {
        toc.length > 0 && (
          <aside class="hidden xl:block">
            <nav aria-label="On this page" class="sticky top-20 text-[0.875rem]">
              <p class="mb-2 font-serif text-[0.8125rem] font-semibold uppercase tracking-wide text-muted">
                On this page
              </p>
              <ul class="m-0 list-none p-0">
                {toc.map((heading) => (
                  <li class:list={["m-0", heading.depth === 3 && "pl-3"]}>
                    <a
                      class="block py-1 leading-snug text-muted transition hover:text-fg"
                      href={`#${heading.slug}`}
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* Docs prose. MDX content is authored in the entry, so the elements do not
     carry this component's scope hash — the `.docs-prose` ancestor is the
     namespace instead. Plain CSS over the Mixar tokens (no typography plugin). */
  .docs-prose {
    color: var(--text);
    font-size: 1rem;
    line-height: 1.7;
  }

  .docs-prose :where(h2, h3, h4) {
    scroll-margin-top: 5rem;
  }

  .docs-prose h2 {
    margin: 2.5rem 0 1rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .docs-prose h3 {
    margin: 1.75rem 0 0.75rem;
    font-size: 1.1875rem;
    font-weight: 600;
  }

  .docs-prose h4 {
    margin: 1.25rem 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .docs-prose p {
    margin: 0;
  }

  .docs-prose p + p,
  .docs-prose :where(ul, ol, table, pre, blockquote, aside) + :where(p, ul, ol) {
    margin-top: 1rem;
  }

  .docs-prose :where(h2, h3, h4) + :where(p, ul, ol, pre) {
    margin-top: 0;
  }

  .docs-prose :where(ul, ol) {
    margin: 1rem 0 0;
    padding-left: 1.4rem;
  }

  .docs-prose ul {
    list-style: disc;
  }

  .docs-prose ol {
    list-style: decimal;
  }

  .docs-prose li {
    margin-top: 0.35rem;
  }

  .docs-prose :where(li > ul, li > ol) {
    margin-top: 0.35rem;
  }

  .docs-prose a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .docs-prose a:hover {
    color: var(--accent-hover);
  }

  .docs-prose strong {
    font-weight: 600;
    color: var(--text);
  }

  .docs-prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 0.35rem;
    padding: 0.1rem 0.3rem;
  }

  .docs-prose pre {
    margin: 1rem 0 0;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1rem 1.1rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .docs-prose pre code {
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0;
    font-size: inherit;
  }

  .docs-prose .docs-table-wrap {
    margin: 1rem 0 0;
    overflow-x: auto;
  }

  .docs-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .docs-prose th,
  .docs-prose td {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
    vertical-align: top;
  }

  .docs-prose thead th {
    background: var(--bg-elevated);
    font-weight: 600;
  }

  .docs-prose blockquote {
    margin: 1rem 0 0;
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    color: var(--muted);
  }

  .docs-prose hr {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .docs-prose :where(aside) {
    margin-top: 1.5rem;
  }

  /* Shiki dual themes: activate the `--shiki-dark*` values when the site's
     data-theme is dark. Astro emits the variables but not this rule. */
  :where([data-theme="dark"]) .docs-prose .astro-code,
  :where([data-theme="dark"]) .docs-prose .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }
</style>
