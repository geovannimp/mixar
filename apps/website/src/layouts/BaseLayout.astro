---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { RELEASES_URL } from "../consts";
import { META_NAME, resolvePosthogHost } from "../scripts/analytics";

interface Props {
  title: string;
  description: string;
  currentPage?: "home" | "developers" | "privacy" | "docs";
  /** Absolute or site-root path; default `/mixar-banner.png` */
  ogImage?: string;
}

const { title, description, currentPage = "home", ogImage } = Astro.props;
const fullTitle = title === "Mixar" ? "Mixar | Free DJ software" : `${title} · Mixar`;

const siteURL = Astro.site ?? new URL("https://mixar.top");
const canonicalURL = new URL(Astro.url.pathname, siteURL);
// Only site-relative image paths are accepted (a full absolute URL would
// bypass origin checking, which the OCR security review flagged as the one
// value a future caller could poison). Absolute-ize via the site origin so
// `og:image`, `twitter:image` and the JSON-LD `image` all share one value.
const ogImagePath = ogImage ?? "/mixar-banner.png";
if (ogImagePath.startsWith("//") || /^[a-z]+:/i.test(ogImagePath)) {
  throw new Error(`BaseLayout ogImage must be a site-root path, got: ${ogImagePath}`);
}
const absOgImage = new URL(ogImagePath, siteURL).href;
const siteOrigin = siteURL.href.endsWith("/") ? siteURL.href : `${siteURL.href}/`;

const organization = {
  "@type": "Organization",
  "@id": `${siteOrigin}#organization`,
  name: "Mixar",
  url: siteOrigin,
  logo: `${siteOrigin}mixar-logo.png`,
  sameAs: ["https://github.com/geovannimp/mixar"],
};

const website = {
  "@type": "WebSite",
  "@id": `${siteOrigin}#website`,
  url: siteOrigin,
  name: "Mixar",
  // Site-level blurb, not the per-page description: WebSite describes the
  // whole site, and OCR review flagged page blurbs bleeding into it on docs.
  description: "Free, open-source DJ software. Dual decks, hot cues, loops, and NI Stems.",
  publisher: { "@id": `${siteOrigin}#organization` },
  inLanguage: "en",
};

const softwareApplication = {
  "@type": "SoftwareApplication",
  "@id": `${siteOrigin}#app`,
  name: "Mixar",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Linux, macOS, Windows",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  downloadUrl: RELEASES_URL,
  url: siteOrigin,
  image: absOgImage,
  description,
  publisher: { "@id": `${siteOrigin}#organization` },
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph":
    currentPage === "home"
      ? [organization, website, softwareApplication]
      : [organization, website],
};

// Analytics is opt-in by configuration, not by consent UI. With no key the
// element below is not rendered, the script's config read returns null, and the
// posthog-js chunk is never fetched — which is the default for local dev and
// for pull requests from forks, since those get no repository secrets.
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY?.trim() ?? "";
// Through the shared helper rather than re-reading the env var, so the endpoint
// the privacy page names and the one events go to cannot drift apart.
const posthogHost = resolvePosthogHost();
// Local-only escape hatch. A wrong host, a bad token or a tracking blocker all
// fail silently, so this makes the SDK narrate itself in the console.
//
// ANDed with DEV on purpose: a PUBLIC_ flag alone is deployable, so a stray
// value in CI would turn on verbose SDK logging for every visitor and expose
// the SDK instance on their console. `astro dev` only — a note in
// .env.example cannot enforce that.
const posthogDebug =
  import.meta.env.DEV && import.meta.env.PUBLIC_POSTHOG_DEBUG === "true";
const analyticsEnabled = posthogKey !== "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mixar" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={absOgImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absOgImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {
      analyticsEnabled && (
        <meta
          name={META_NAME}
          data-key={posthogKey}
          data-host={posthogHost}
          data-debug={posthogDebug ? "true" : undefined}
        />
      )
    }
    <script is:inline>
      (function () {
        // Dark is the marketing default — the product itself is a dark booth
        // and every award reference this design derives from sits on a dark
        // canvas. An explicit stored choice (either direction) always wins.
        const stored = localStorage.getItem("theme");
        const theme = stored === "light" || stored === "dark" ? stored : "dark";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <a
      class="absolute -left-[9999px] top-0 z-1000 rounded-sm bg-accent px-4 py-3 font-semibold text-white focus-visible:left-4 focus-visible:top-4"
      href="#main">Skip to content</a
    >
    <Header currentPage={currentPage} />
    <main id="main">
      <slot />
    </main>
    <Footer currentPage={currentPage} />
    <span id="theme-status" class="sr-only" aria-live="polite" aria-atomic="true"></span>
    <script>
      import { initRevealGroups } from "../scripts/features-reveal";

      const toggle = document.getElementById("theme-toggle");
      const themeStatus = document.getElementById("theme-status");
      toggle?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
        if (themeStatus) {
          themeStatus.textContent = `${next === "dark" ? "Dark" : "Light"} theme enabled`;
        }
      });

      initRevealGroups();
    </script>
    <script>
      import { initAnalytics } from "../scripts/analytics";

      // Resolves immediately with no key configured; the SDK is behind a dynamic
      // import so an unconfigured build never fetches it.
      void initAnalytics();
    </script>
  </body>
</html>
