# PostHog project token for the marketing site.
#
# The token is public and write-only by design — the same value ships to every
# visitor of a browser app — so this is not a secret and the file is safe to
# commit. `.env` itself is gitignored; copy this file to `.env` to fill it in
# locally.
#
# Leave PUBLIC_POSTHOG_KEY unset to disable analytics entirely: BaseLayout then
# emits no config element, the SDK chunk is never fetched, and no request is
# made to any PostHog host. That is also what happens on pull requests from
# forks, which do not get repository secrets.
#
# In the deployed site the token is injected from the POSTHOG_PROJECT_KEY
# repository secret by .github/workflows/pages.yml.
PUBLIC_POSTHOG_KEY=

# EU region. Omit to use the built-in EU default; posthog-js would otherwise
# fall back to us.i.posthog.com, which would move visitor data to the US.
#
# The ingestion host has an "i" in it: eu.i.posthog.com, not eu.posthog.com.
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Local troubleshooting only. A wrong host, a bad token, or a tracking blocker
# all fail silently, so set this to true to have the SDK narrate itself in the
# browser console. Never set it on a deployed build.
PUBLIC_POSTHOG_DEBUG=false
