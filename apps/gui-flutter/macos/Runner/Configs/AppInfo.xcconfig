// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Mixar

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = top.mixar.app

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 Mixar. All rights reserved.

// Release builds include Intel and Apple Silicon. The Rust pod supplies a
// matching ONNX Runtime for each slice (see rust_builder/cargokit).
ARCHS = $(ARCHS_STANDARD)

// ONNX Runtime's macOS prebuilt is compiled for macOS 13.4 and is force-loaded
// into the app, so that is the real floor regardless of the project default
// (10.15). Keep in sync with the podspec, which sets the same value.
MACOSX_DEPLOYMENT_TARGET = 13.4
