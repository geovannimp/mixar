+/// Handle that demotes the audio thread from any thread.
+///
+/// CPAL 0.18.2 tears the PipeWire stream down in the `StreamCommand::Stop`
+/// handler, before the promoter itself is dropped. Demoting only in
+/// `RtPromoter::drop` is too late there: the kernel can deliver `SIGXCPU` while
+/// `pw_impl_node_destroy` runs. The stream hands this handle to the stop
+/// handler so the thread is demoted first.
+#[derive(Clone)]
+pub(crate) struct RtPromoterHandle {
+    thread_info: audio_thread_priority::RtPriorityThreadInfo,
+    promoted: Arc<AtomicBool>,
+    /// Set once the stream begins tearing down; blocks later promotions.
+    stop: Arc<AtomicBool>,
+    /// Serializes promotion with demotion so demote waits for an in-flight promote.
+    promotion: Arc<Mutex<()>>,
+    error_callback: ErrorCallbackArc,
+}
+
+impl RtPromoterHandle {
+    /// Demote the audio thread if it is still promoted. Idempotent.
+    pub(crate) fn demote(&self) {
+        let _guard = self.promotion.lock().unwrap_or_else(|e| e.into_inner());
+        self.stop.store(true, Ordering::Relaxed);
+        if self.promoted.swap(false, Ordering::Relaxed) {
+            if let Err(e) =
+                audio_thread_priority::demote_thread_from_real_time(self.thread_info)
+            {
+                emit_error(&self.error_callback, Error::from(e));
+            }
+        }
+    }
+}
+
 pub(crate) struct RtPromoter {
     pending_frames: Arc<AtomicU32>,
     shutdown: Arc<AtomicBool>,
     handle: Thread,
     join: Option<JoinHandle<()>>,
+    demote: RtPromoterHandle,
 }
 
